\title{A software-defined tensor streaming multiprocessor for large-scale machine learning}
\date{2022-06}
\author/literal{Dennis Abts}\author/literal{Garrin Kimmell}\author/literal{Andrew Ling}\author/literal{John Kim}\author/literal{Matt Boyd}\author/literal{Andrew Bitar}\author/literal{Sahil Parmar}\author/literal{Ibrahim Ahmed}\author/literal{Roberto DiCecco}\author/literal{David Han}\author/literal{John Thompson}\author/literal{Michael Bye}\author/literal{Jennifer Hwang}\author/literal{Jeremy Fowers}\author/literal{Peter Lillian}\author/literal{Ashwin Murthy}\author/literal{Elyas Mehtabuddin}\author/literal{Chetan Tekur}\author/literal{Thomas Sohmers}\author/literal{Kris Kang}\author/literal{Stephen Maresh}\author/literal{Jonathan Ross}
