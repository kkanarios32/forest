\title{The Infinity Machine: Demis Hassabis, DeepMind, and the Quest for Superintelligence}
\date{2026-03}
\author/literal{Sebastian Mallaby}
\taxon{Reference}
\meta{bibtex}{\startverb
@book{mallabyInfinityMachineDemis2026,
 title = {The {{Infinity Machine}}: {{Demis Hassabis}}, {{DeepMind}}, and the {
{Quest}} for {{Superintelligence}}},
 author = {Mallaby, Sebastian},
 year = {2026},
 isbn = {978-0-593-83184-7},
 publisher = {Penguin Group},
 keywords = {Business & Economics / Industries / Computers & Information
Technology,Science / Philosophy & Social Aspects,Technology &
