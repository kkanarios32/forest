\title{Autocomp: A Powerful and Portable Code Optimizer for Tensor Accelerators}
\date{2025-11}
\author/literal{Charles Hong}\author/literal{Sahil Bhatia}\author/literal{Alvin Cheung}\author/literal{Yakun Sophia Shao}
