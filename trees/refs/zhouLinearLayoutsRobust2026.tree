\title{Linear Layouts: Robust Code Generation of Efficient Tensor Computation Using $\mathbb_2$}
\date{2026-03}
\author/literal{Keren Zhou}\author/literal{Mario Lezcano}\author/literal{Adam Goucher}\author/literal{Akhmed Rakhmati}\author/literal{Jeff Niu}\author/literal{Justin Lebar}\author/literal{Pawel Szczerbuk}\author/literal{Peter Bell}\author/literal{Phil Tillet}\author/literal{Thomas Raoux}\author/literal{Zahi Moudallal}
