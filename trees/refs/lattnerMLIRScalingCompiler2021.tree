\title{MLIR: Scaling Compiler Infrastructure for Domain Specific Computation}
\date{2021-02}
\author/literal{Chris Lattner}\author/literal{Mehdi Amini}\author/literal{Uday Bondhugula}\author/literal{Albert Cohen}\author/literal{Andy Davis}\author/literal{Jacques Pienaar}\author/literal{River Riddle}\author/literal{Tatiana Shpeisman}\author/literal{Nicolas Vasilache}\author/literal{Oleksandr Zinenko}
