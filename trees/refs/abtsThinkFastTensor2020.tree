\title{Think Fast: A Tensor Streaming Processor (TSP) for Accelerating Deep Learning Workloads}
\date{2020-05}
\author/literal{Dennis Abts}\author/literal{Jonathan Ross}\author/literal{Jonathan Sparling}\author/literal{Mark Wong-VanHaren}\author/literal{Max Baker}\author/literal{Tom Hawkins}\author/literal{Andrew Bell}\author/literal{John Thompson}\author/literal{Temesghen Kahsai}\author/literal{Garrin Kimmell}\author/literal{Jennifer Hwang}\author/literal{Rebekah Leslie-Hurd}\author/literal{Michael Bye}\author/literal{E. R. Creswick}\author/literal{Matthew Boyd}\author/literal{Mahitha Venigalla}\author/literal{Evan Laforge}\author/literal{Jon Purdy}\author/literal{Purushotham Kamath}\author/literal{Dinesh Maheshwari}\author/literal{Michael Beidler}\author/literal{Geert Rosseel}\author/literal{Omar Ahmad}\author/literal{Gleb Gagarin}\author/literal{Richard Czekalski}\author/literal{Ashay Rane}\author/literal{Sahil Parmar}\author/literal{Jeff Werner}\author/literal{Jim Sproch}\author/literal{Adrian Macias}\author/literal{Brian Kurtz}
