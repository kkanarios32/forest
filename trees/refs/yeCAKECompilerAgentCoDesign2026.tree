\title{CAKE: Compiler-Agent Co-Design for Frontier Kernel Evolution}
\date{2026-08}
\author/literal{Zihao Ye}\author/literal{Yingyi Huang}\author/literal{Hongyi Jin}\author/literal{Bohan Hou}\author/literal{Junru Shao}\author/literal{Zhongming Yu}\author/literal{Jinqi Chen}\author/literal{Meghan Cowan}\author/literal{Shiyi Cao}\author/literal{Shanli Xing}\author/literal{Hanfeng Chen}\author/literal{Vinod Grover}\author/literal{Tianqi Chen}\author/literal{Luis Ceze}
