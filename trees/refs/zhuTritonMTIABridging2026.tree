\title{Triton for MTIA: Bridging the Programming Model Gaps for Custom AI Accelerators}
\date{2026-08}
\author/literal{Haishan Zhu}\author/literal{Domi Yan}\author/literal{Michael Levesque-Dion}\author/literal{Changxu Zhang}\author/literal{Mitch Gamburg}\author/literal{Kirsten Lee}\author/literal{Giancarlo Colmenares}\author/literal{Aditya Bhagwat}\author/literal{Arnab De}\author/literal{Markus Le Roux}\author/literal{Victor Perez Carrasco}\author/literal{Xin Tong}\author/literal{Will Cromar}\author/literal{Simran Barnwal}\author/literal{Andrew Uderian}\author/literal{Sridhar Gopinath}\author/literal{Jan Szczepaniec}\author/literal{Daniel Neilson}\author/literal{Blaine Burton Rister}\author/literal{Jordan Fix}\author/literal{Jazlyn Li}\author/literal{Zejun Huang}\author/literal{Lite Ye}\author/literal{Nan Zhang}\author/literal{Xinchen Guo}\author/literal{Andiry Xu}\author/literal{Michael Roberts}\author/literal{Kunming Ho}\author/literal{Site Cao}\author/literal{Suryadev Sahadevan Rajesh}\author/literal{Tristan Trouwen}\author/literal{Mike Tsai}\author/literal{Jake Lee}\author/literal{Wayne Su}\author/literal{Yuhan Chen}\author/literal{Xiaolong Xie}\author/literal{David Eklov}\author/literal{Aaron Barnes}\author/literal{Max Bremer}\author/literal{Adam Belay}\author/literal{Shintaro Iwasaki}\author/literal{Roman Levenstein}\author/literal{Ajit Mathews}
