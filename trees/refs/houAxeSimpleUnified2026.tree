@misc{houAxeSimpleUnified2026,
 title = {Axe: {{A Simple Unified Layout Abstraction}} for {{Machine Learning Compilers}}},
 author = {Hou, Bohan and Jin, Hongyi and Wang, Guanjie and Chen, Jinqi and Cai, Yaxing and Yang, Lijie and Ye, Zihao and Ding, Yaoyao and Lai, Ruihang and Chen, Tianqi},
 year = {2026},
 doi = {10.48550/arXiv.2601.19092},
 urldate = {2026-08-06},
 number = {arXiv:2601.19092},
