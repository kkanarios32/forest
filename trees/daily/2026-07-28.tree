\p{\strong{10:07 AM}}
\hr
\p{\em{Today's [[hofstadterGodelEscherBach1999]]}. This cahpter was all about \em{typographical number theory} (TNT). This builds on propositional logic by}
\ol{
  \li{expanding \em{atoms} from opaque to having a structure. We now get numerals #{0, S0, SS0, \ldots} and variables #{a,b,c,d,e,a',\ldots}}
  \li{we have quantifiers #{\forall x, x \in A} and #{\exists x, x \in A}}
  \li{introduce \em{Peano's axioms}.}
  \li{introduce \em{induction} via the obscure notation #{X\{u\}} for #{X} as a function of #{u} and the conditions #{X\{Su / u\} X\{0 / u\}} for #{u \implies u+1} in induction and the base case holds for #{u=0}.}
}
