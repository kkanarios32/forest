\tag{public}

\title{basic macros}
\import{latex-preamble}

\xmlns:html{http://www.w3.org/1999/xhtml}

\def\nowrap[body]{\<html:span>[style]{white-space: nowrap}{\body}}

\def\#[body]{
  \startverb#\stopverb\body
}

\def\smile[body]{
  \startverb:)\stopverb\body
}
\def\colblock[body]{
 \<html:div>[class]{jms-indent-block}[style]{
  margin-left: 1em;
  margin-bottom: 1em;
  border-left: 4px solid black;
  padding-left: 12px;
  background-color: whitesmoke;
  }{\body}
}

\def\quote[body]{
 \<html:blockquote>[class]{jms-quote}[style]{
  margin: 1em 0 1em 0.25em;
  padding: 0.6em 1.1em 0.6em 1.3em;
  border-left: 4px solid rgba(0, 0, 0, 0.25);
  border-radius: var(--radius);
  background-color: rgba(0, 0, 0, 0.035);
  font-style: italic;
  color: rgba(0, 0, 0, 0.85);
  }{\body}
}

\def\quotes[body][source]{
 \<html:blockquote>[class]{jms-quote}[style]{
  margin: 1em 0 1em 0.25em;
  padding: 0.6em 1.1em 0.6em 1.3em;
  border-left: 4px solid rgba(0, 0, 0, 0.25);
  border-radius: var(--radius);
  background-color: rgba(0, 0, 0, 0.035);
  font-style: italic;
  color: rgba(0, 0, 0, 0.85);
  }{\body\<html:div>[style]{
   margin-top: -0.5em;
   font-style: normal;
   font-size: 0.9em;
   text-align: right;
   color: rgba(0, 0, 0, 0.55);
  }{— \source}}
}

% Callout asides (Problem./Question./Remark./…). A tinted, left-bordered block
% in the \quote house style, led by a bold colored label. These render inline
% wherever they appear (including inside \li) rather than as their own \subtree,
% so they need no taxon and take no TOC/numbering. \accent tints the border and
% label; \tint is the (much lighter) background. Pass rgba(...) colors, never
% #hex — Forester eats a bare #.
\def\callout[accent][tint][label][body]{
 \<html:div>[class]{jms-callout}[style]{
  margin: 1em 0 1em 0.25em;
  padding: 0.5em 1.1em 0.5em 1.2em;
  border-left: 4px solid \accent;
  border-radius: var(--radius);
  background-color: \tint;
  }{\<html:span>[style]{font-weight: 600; color: \accent;}{\label} \body}
}

\def\irow[body]{
 \<html:div>[class]{jms-indent-row}[style]{min-height: 1em}{\body}
}

\def\mark[body]{\<html:mark>{\body}}

% LaTeX-style run-in heading. \paragraph{Word} renders a bold sans lead-in
% label with a trailing period — "Word." — after which the sentence continues
% inline. Replaces the bold-label-with-colon idiom so the label pops in the
% sans (var(--sans)) against the serif body. Pass the label WITHOUT punctuation;
% the macro adds the period. The argument may hold links/math (\paragraph{[[ID]]}).
\def\paragraph[head]{\<html:strong>[style]{font-family: var(--sans); font-weight: 500;}{\head.}}

\def\lsquare{\startverb[\stopverb}
\def\rsquare{\startverb]\stopverb}
\def\lparen{\startverb(\stopverb}
\def\rparen{\startverb)\stopverb}

\def\closed-open[x]{\lsquare\x\rparen}
\def\open-closed[x]{\lparen\x\rsquare}

\def\collapsed[t][body]{
 \scope{
    \put\transclude/toc{false}
    \put\transclude/expanded{false}
    \subtree{
      \title{\t}
      \body
   }
 }
}

\def\citek[refid]{\let\escape[x]{\x}\<html:span>[class]{link-reference}{[\escape{[\refid]}](\refid)}}

\def\citet[tid][refid]{\let\escape[x]{\x}\<html:span>[class]{link-reference}[tid]{\tid}[refid]{\refid}{[\escape{[\refid, \tid]}](\refid)}}

\def\note[name][body]{
    \title{\name}
    \body
}


\def\refnote[name][reference][body]{
  \note{\name \citek{\reference}}{\body}
}

\def\refnotet[name][tid][reference][body]{%
  \title{\name \citet{\tid}{\reference}}
  \body
}

\def\refcard[taxa][name][reference][body]{\subtree{\taxon{\taxa}\refnote{\name}{\reference}{\body}}}

\def\refcardt[taxa][name][tid][reference][body]{
  \scope{
    \put\transclude/toc{false}
    \put\transclude/numbered{false}
    \subtree{
      \taxon{\taxa}\refnotet{\name}{\tid}{\reference}{\body}
    }
  }
}

\def\embed[src]{
  \<html:embed>[type]{text/html}[src]{\src}{}
}

\def\table[body]{
  \<html:table>{\body}
}
\def\tr[body]{
  \<html:tr>{\body}
}
\def\td[body]{
  \<html:td>{\body}
}
\def\th[body]{
  \<html:th>{\body}
}
\def\hr{
  \<html:hr>{}
}

% Syntax-highlighted code block. Wraps a \verb body in <pre><code
% class="language-<lang>"> so highlight.js (vendored in theme/, run on load
% from tree.xsl) can tokenize it; token colors live in theme/style.css. The
% body must still be \verb<<<|...<<< so backslashes/braces pass through raw.
% Usage:  \codeblock{lua}{\verb<<<|  ...code...  <<<}
% Languages: the hljs core bundle (bash, c, cpp, python, lua, rust, js, ts,
% json, yaml, sql, go, java, ...). Unknown/blank lang → hljs auto-detects.
\def\codeblock[lang][body]{\<html:pre>{\<html:code>[class]{language-\lang}{\body}}}

% Same as \codeblock but with a filename/title bar above the code (rendered by
% the .code-figure / .code-filename rules in theme/style.css). Use when the
% snippet is a named source file.  Usage:
%   \codeblockf{flash_attention.py}{python}{ ...code... }
\def\codeblockf[file][lang][body]{\<html:div>[class]{code-figure}{\<html:div>[class]{code-filename}{\file}\<html:pre>{\<html:code>[class]{language-\lang}{\body}}}}

% Utterances comment thread for a blog post. Wrapped in a .comments div so the
% theme can suppress it whenever the post is transcluded (expanded on an index
% or the home page) and render it only on the post's own page — see the
% html:div[@class='comments'] rule in theme/core.xsl. The argument is the
% utterances issue-term (usually \comments{pathname}; a fixed slug otherwise).
\def\comments[term]{
  \<html:div>[class]{comments}{
    \hr
    \<html:script>[src]{https://utteranc.es/client.js}[repo]{kkanarios32/website-comments}[issue-term]{\term}[theme]{boxy-light}[crossorigin]{anonymous}[async]{}{}
  }
}

% Buttondown subscribe form. Deliberately script-free: it is a plain POST, so
% it works with no embed script and nothing to block. Submitting navigates to
% Buttondown's own confirmation page.
%
% `kanarios` is the Buttondown newsletter username; the endpoint 404s if it
% ever changes. Rendering is guarded in theme/core.xsl so the form appears
% only on its own page, never in a transclusion or hover-preview.
\def\subscribe{
  \<html:form>[class]{embeddable-buttondown-form}[method]{post}[action]{https://buttondown.com/api/emails/embed-subscribe/kanarios}[style]{
   margin: 1.5em 0;
   padding: 0.9em 1.1em;
   border-left: 4px solid rgba(60, 90, 180, 0.8);
   border-radius: var(--radius);
   background-color: rgba(60, 90, 180, 0.05);
  }{
   \<html:div>[style]{font-weight: 600; margin-bottom: 0.25em;}{Subscribe by email}
   \<html:div>[style]{
    font-size: 0.92em;
    margin-bottom: 0.75em;
    color: rgba(0, 0, 0, 0.7);
   }{New posts in full, whenever I publish. Nothing else.}
   \<html:input>[type]{email}[name]{email}[placeholder]{you@example.com}[required]{required}[style]{
    padding: 0.4em 0.6em;
    margin-right: 0.4em;
    border: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: var(--radius);
    font-size: 0.95em;
    min-width: 15em;
   }{}
   \<html:input>[type]{hidden}[name]{embed}[value]{1}{}
   \<html:input>[type]{submit}[value]{Subscribe}[style]{
    padding: 0.4em 0.9em;
    border: 1px solid rgba(60, 90, 180, 0.8);
    border-radius: var(--radius);
    background-color: rgba(60, 90, 180, 0.8);
    color: white;
    font-size: 0.95em;
    cursor: pointer;
   }{}
  }
}

\def\stub{
 \<html:div>[class]{stub-notice}[style]{
  margin: 0.5em 0;
  padding: 8px 12px;
  border-left: 4px solid #7cb342;
  background-color: #f1f8e9;
  color: #33691e;
  font-style: italic;
  }{🌱 Stub — this concept is referenced but not yet written.}
}

\alloc\base/tex-preamble

\def\latex[body]{
  \tex{\latex-preamble}{\body}
}

\def\example[body]{\callout{rgba(60, 90, 180, 0.8)}{rgba(60, 90, 180, 0.05)}{Example.}{\body}}

% The answer side of a spaced-repetition card. A card tree (trees/cards/) is
% \taxon{Card} with \title{<question>} and this \prompt{<answer>} as its body;
% the theme paints the whole Card-taxon section (question + answer) as one blue
% card (see style.css). The tree id is the card's stable identity and
% scripts/anki-sync mirrors \title -> Front and \prompt -> Back to Anki, writing
% the note id back as \meta{anki}{...}.
\def\prompt[back]{\p{\back}}

\def\proof[body]{\callout{rgba(0, 0, 0, 0.4)}{rgba(0, 0, 0, 0.03)}{Proof.}{\body}}

\def\md[body]{\<html:div>[class]{markdownit grace-loading}{\body}}

\def\block[tit][body]{%
    \subtree{%
      \title{\tit}
      \body
    }
}

\def\mdblock[t][body]{\block{\t}{\md{\body}}}

\def\remark[body]{\callout{rgba(90, 90, 110, 0.7)}{rgba(90, 90, 110, 0.05)}{Remark.}{\body}}

\def\notation[body]{\callout{rgba(70, 100, 150, 0.75)}{rgba(70, 100, 150, 0.05)}{Notation.}{\body}}

\def\claim[body]{\callout{rgba(140, 60, 170, 0.8)}{rgba(140, 60, 170, 0.05)}{Claim.}{\body}}

\def\question[body]{\callout{rgba(200, 130, 0, 0.9)}{rgba(200, 130, 0, 0.06)}{Question.}{\body}}

\def\answer[body]{\callout{rgba(0, 140, 120, 0.9)}{rgba(0, 140, 120, 0.06)}{Answer.}{\body}}

\def\problem[body]{\callout{rgba(200, 55, 45, 0.85)}{rgba(200, 55, 45, 0.06)}{Problem.}{\body}}

% Procedure / pseudocode block. Keeps the old \iblock blue as its identity.
\def\algorithm[body]{\callout{rgba(0, 100, 255, 0.7)}{rgba(0, 100, 255, 0.05)}{Algorithm.}{\body}}

% A stated objective — what we are trying to achieve.
\def\goal[body]{\callout{rgba(190, 50, 130, 0.85)}{rgba(190, 50, 130, 0.06)}{Goal.}{\body}}

\def\idea[body]{\callout{rgba(190, 50, 130, 0.85)}{rgba(190, 50, 130, 0.06)}{💡 Idea.}{\body}}

% A highlighted key takeaway / "aha".
\def\insight[body]{\callout{rgba(0, 160, 175, 0.9)}{rgba(0, 160, 175, 0.06)}{💡 Insight.}{\body}}

\def\section[tit][body]{
  \subtree{
    \title{\tit}
    \body
  }
}

\def\card[taxa][name][body]{\subtree{\taxon{\taxa}\note{\name}{\body}}}

\def\solution[body]{\callout{rgba(40, 150, 80, 0.9)}{rgba(40, 150, 80, 0.06)}{Solution.}{\body}}

\def\tdtask[id][body]{\li{\body}}
\def\tdtaskx[id][body]{\li{\<html:s>{\body}}}
