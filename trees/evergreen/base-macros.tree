\tag{public}

\title{basic macros}
\import{latex-preamble}

\xmlns:html{http://www.w3.org/1999/xhtml}

\def\nowrap[body]{\<html:span>[style]{white-space: nowrap}{\body}}

\def\#[body]{
  \startverb#\stopverb\body
}

\def\smile[body]{
  \startverb:)\stopverb\body
}
\def\colblock[body]{
 \<html:div>[class]{jms-indent-block}[style]{
  margin-left: 1em;
  margin-bottom: 1em;
  border-left: 4px solid black;
  padding-left: 12px;
  background-color: whitesmoke;
  }{\body}
}

% ── The palette: vellum ─────────────────────────────────────────────────────
%
% Every color on the site, as a bare "r, g, b" triple — spelled rgb(\cal-claim)
% for a rule or label and rgb(\cal-claim-tint) for the fill behind it. Bare
% #hex cannot be used anywhere, since Forester reads # as the start of math,
% which is why these are triples rather than colors.
%
% Six roles, not one hue per macro, and the grouping is the design: the label
% already says whether an aside is a Goal or an Insight, so color is spent on
% the coarser question of what *kind* of thing is being said. Example, Goal,
% Idea and Insight are all the author pointing at something and share the
% green; Claim and Prediction are both assertions and share the plum. Nine
% hues over fifteen macros made a math page look like a paint chart.
%
% Each role carries three values, of which the accent does nearly all the
% work: it is the rule and the label both, dark enough to be read as text
% (5.6-7.9 contrast on white — the previous palette ran 2.7-6.0 and the
% lightest of it was illegible).
%
% The tints are the fills, and nothing fills any more — see \callout, where
% the tint every call site passes is dropped. They are kept because they are
% still the theme's ground for the one panel that survives (the Card frame in
% theme/style.css), and because keeping them is what makes the switch back to
% a filled site a four-line edit in one macro rather than a rewrite of fifteen.
%
% The rules are the pale variants, used where a rule should not carry the
% accent's full weight. Only neutral needs one: Remark and Notation are half of
% every callout in the forest, so they take a hairline under a readable label,
% and every other role runs its accent through both.
\def\cal-neutral{109, 103, 101}          % \remark, \notation, \proof
\def\cal-neutral-tint{249, 242, 239}
\def\cal-neutral-rule{219, 216, 215}

\def\cal-example{38, 97, 69}             % \example, \goal, \idea, \insight, \stub
\def\cal-example-tint{236, 247, 240}
\def\cal-example-rule{201, 224, 210}

\def\cal-question{115, 73, 35}           % \question, \answer, \foldbox
\def\cal-question-tint{251, 241, 234}
\def\cal-question-rule{233, 213, 198}

\def\cal-problem{121, 65, 66}            % \problem, \solution
\def\cal-problem-tint{253, 240, 239}
\def\cal-problem-rule{237, 210, 209}

\def\cal-claim{110, 67, 101}             % \claim, \prediction
\def\cal-claim-tint{250, 240, 247}
\def\cal-claim-rule{230, 210, 225}

\def\cal-algorithm{63, 83, 127}          % \algorithm, Card + its answer
\def\cal-algorithm-tint{239, 244, 253}
\def\cal-algorithm-rule{207, 217, 238}

% A quotation, in the same clothes as a callout: a hairline in the margin and
% no fill. Someone else's words are already marked as theirs by the italic and
% by whatever introduces them, so the rule is there to hold the block together
% down the left, not to fence it off.
\def\quote[body]{
 \<html:blockquote>[class]{jms-quote}[style]{
  margin: 1.1rem 0;
  padding: 0.1rem 0 0.1rem 0.9rem;
  border-left: 2px solid rgb(\cal-neutral-rule);
  font-style: italic;
  color: rgba(0, 0, 0, 0.85);
  }{\body}
}

% The same, attributed. The source line takes the neutral accent rather than a
% grey of its own — it is the quietest thing in the block and should be the one
% color the rest of the page already uses for quiet things.
\def\quotes[body][source]{
 \<html:blockquote>[class]{jms-quote}[style]{
  margin: 1.1rem 0;
  padding: 0.1rem 0 0.1rem 0.9rem;
  border-left: 2px solid rgb(\cal-neutral-rule);
  font-style: italic;
  color: rgba(0, 0, 0, 0.85);
  }{\body\<html:div>[style]{
   margin-top: -0.5em;
   font-style: normal;
   font-size: 0.9em;
   text-align: right;
   color: rgb(\cal-neutral);
  }{— \source}}
}

% Callout asides (Problem./Question./Remark./…), and the whole of what one is:
% a rule in the margin, a colored label, and the prose. No fill, no box. These
% render inline wherever they appear (including inside \li) rather than as
% their own \subtree, so they need no taxon and take no TOC/numbering.
%
% \accent colors the label; \rule draws the line. They are separate arguments
% because the two are not always the same weight of statement — the neutral
% asides take a pale hairline under a readable label, everything else runs the
% accent through both. Pass rgb(\cal-...) from the palette above, never #hex.
%
% The padding is asymmetric on purpose: with no fill there is nothing to inset
% from, so the block keeps only the gap between the rule and the text, and the
% prose inside a callout stays on the same measure as the prose around it.
\def\calloutbare[accent][rule][label][body]{
 \<html:div>[class]{jms-callout}[style]{
  margin: 1.1rem 0;
  padding: 0.1rem 0 0.1rem 0.9rem;
  border-left: 2px solid \rule;
  }{\<html:span>[style]{font-weight: 500; color: \accent;}{\label} \body}
}

% The filled form — except that it no longer fills. Every callout on the site
% is now a rule and a label, and this is where that is decided: \tint is still
% taken from every call site, and is deliberately dropped on the floor.
%
% The reason is what a fill costs at this scale. A tinted box says "this is set
% apart", which works when one appears; a page carrying six says nothing at
% all, and a notebook of thirty is a stack of blocks with prose trapped between
% them. The rule makes the same distinction at a fraction of the volume, and it
% leaves the page reading as a page.
%
% Every call site still passes its tint, so this is the switch: restore the
% four lines below and the site is filled again, no other edit anywhere.
%
%   \def\callout[accent][tint][label][body]{
%    \<html:div>[class]{jms-callout}[style]{
%     margin: 1.1rem 0; padding: 0.6rem 0.9rem;
%     border-left: 3px solid \accent; background-color: \tint;
%     }{\<html:span>[style]{font-weight: 500; color: \accent;}{\label} \body}}
%
% Defined after \calloutbare and not before it: a macro body is expanded
% against the definitions in scope at that point, so the order here is load
% bearing — \callout named before \calloutbare exists leaves the literal text
% in the output.
\def\callout[accent][tint][label][body]{
  \calloutbare{\accent}{\accent}{\label}{\body}
}

% A sidenote: a numbered marker where you are reading, the note itself out in
% the right margin beside that line. \sidenote{...} in the middle of a sentence
% and nothing else — the number is a CSS counter, so notes renumber themselves
% when a paragraph moves and there is no state here to get out of step.
%
% A marker followed immediately by its note, and no wrapper around the pair:
% the marker increments the counter and the note, being its next sibling, reads
% the value the marker just set. Everything visual — the float into the gutter,
% the margin that carries it there, the click-to-open on a narrow screen — is
% in theme/style.css, since a float into a gutter depends on the page grid and
% no inline style can see it.
%
% The marker is a <label> around a hidden checkbox rather than a bare span,
% which is the whole mechanism for the narrow-screen case: below 1300px there
% is no margin to float into, so the note stays closed and the marker is what
% opens it — a click toggles the checkbox, and CSS does the rest. No script, no
% ids to keep unique. Above 1300px the checkbox is inert and the note is simply
% in the margin.
%
% Prefer a sidenote to a parenthesis when the aside is a real digression, and
% a \remark to a sidenote when it is a qualification the next sentence depends
% on: the margin is read at a glance or not at all. A sidenote never breaks the
% sentence it annotates at any width, so it can be written mid-clause.
\def\sidenote[body]{\<html:label>[class]{sidenote-ref}{\<html:input>[type]{checkbox}{}}\<html:span>[class]{sidenote}{\body}}

\def\irow[body]{
 \<html:div>[class]{jms-indent-row}[style]{min-height: 1em}{\body}
}

\def\mark[body]{\<html:mark>{\body}}

% LaTeX-style run-in heading. \paragraph{Word} renders a bold sans lead-in
% label with a trailing period — "Word." — after which the sentence continues
% inline. Replaces the bold-label-with-colon idiom so the label pops in the
% sans (var(--sans)) against the serif body. Pass the label WITHOUT punctuation;
% the macro adds the period. The argument may hold links/math (\paragraph{[[ID]]}).
\def\paragraph[head]{\<html:strong>[style]{font-family: var(--serif); font-weight: 700; font-style: italic;}{\head.}}

\def\lsquare{\startverb[\stopverb}
\def\rsquare{\startverb]\stopverb}
\def\lparen{\startverb(\stopverb}
\def\rparen{\startverb)\stopverb}

\def\closed-open[x]{\lsquare\x\rparen}
\def\open-closed[x]{\lparen\x\rsquare}

\def\collapsed[t][body]{
 \scope{
    \put\transclude/toc{false}
    \put\transclude/expanded{false}
    \subtree{
      \title{\t}
      \body
   }
 }
}

% A click-to-expand block: a bare <details> with its label as the control.
%
% This is deliberately NOT a \subtree, which is the obvious way to fold
% something in Forester — \collapsed does exactly that, and it is the right
% tool when the thing being folded is a real section of the document. A proof,
% a solution, an answer is not. Making it a tree gave each one a title, an
% author, a date, an entry in the graph, and — the tell — an ancestor path
% prefix, because Forester prepends the path whenever a subtree's designated
% parent differs from the enclosing scope, and an anonymous \section leaves its
% children pointing at the root. So a proof inside a section rendered as
% "Online Softmax › Proof": the page reintroducing itself, once per proof.
%
% None of that is wanted. What is wanted is a disclosure widget, and HTML has
% one. \<html:...> passes through generically (the html:* template in
% theme/core.xsl), so this emits a real <details> holding nothing but the
% label and the body — no id, no metadata, no ancestor path, no participation
% in backlinks or \query.
%
% The theme hides the browser's own disclosure marker site-wide
% (details>summary::marker), so the triangle has to be built: the class here is
% what .foldout in theme/style.css hangs it on. That rule cannot move into an
% inline style, because the glyph depends on whether the <details> is open, and
% no inline style can see state.
% \sty styles the label, which is also the click target and the thing the
% triangle inherits its color from — so a folded callout hands its accent in
% here and the control comes out looking like the label it replaced, rather
% than like a piece of UI bolted to the box.
\def\foldoutas[sty][t][body]{
  \<html:details>{\<html:summary>{\<html:span>[class]{foldout}[style]{\sty}{\t}}\body}
}

% The quiet control. Sans, below body size, grey: this is the styling for a
% fold whose label names no category — "Answer", "Solution" — and so is pure
% affordance. It has to stay out of the way of the heading above it, which is
% the thing being answered and the thing worth reading first.
\def\foldout-control{font-family: var(--sans); font-size: 11pt; font-weight: 500; color: rgba(0, 0, 0, 0.65);}

% A fold-out with nothing around it: the control, unadorned.
\def\foldout[t][body]{\foldoutas{\foldout-control}{\t}{\body}}

% A callout whose body is withheld behind its own label: the box is drawn from
% the start, and the label doubles as the control that opens it. This is the
% shape every "second half" of something takes here — a card's answer, an
% exercise's solution, a proof — because seeing the frame is what cues the
% attempt at recall or derivation before the contents are on screen.
%
% The label moves into the fold control rather than staying in \callout's own
% label slot, so nothing is printed twice — and it takes the accent with it,
% weight and period and all. A folded Proof and an open Remark sitting on the
% same page should read as the same kind of thing, one of which happens to be
% closed; the only difference is the triangle, which inherits the accent too.
%
% Defined here, immediately after \foldoutas, and not up with \callout: a macro
% body is expanded against the definitions in scope at that point, so a
% reference to a fold-out before its definition leaves the literal text in the
% output. Anything folding a callout must therefore come after both.
\def\foldcallout[accent][tint][label][body]{
  \callout{\accent}{\tint}{}{\foldoutas{font-weight: 500; color: \accent;}{\label.}{\body}}
}

\def\citek[refid]{\let\escape[x]{\x}\<html:span>[class]{link-reference}{[\escape{[\refid]}](\refid)}}

\def\citet[tid][refid]{\let\escape[x]{\x}\<html:span>[class]{link-reference}[tid]{\tid}[refid]{\refid}{[\escape{[\refid, \tid]}](\refid)}}

\def\note[name][body]{
    \title{\name}
    \body
}


\def\refnote[name][reference][body]{
  \note{\name \citek{\reference}}{\body}
}

\def\refnotet[name][tid][reference][body]{%
  \title{\name \citet{\tid}{\reference}}
  \body
}

\def\refcard[taxa][name][reference][body]{\subtree{\taxon{\taxa}\refnote{\name}{\reference}{\body}}}

\def\refcardt[taxa][name][tid][reference][body]{
  \scope{
    \put\transclude/toc{false}
    \put\transclude/numbered{false}
    \subtree{
      \taxon{\taxa}\refnotet{\name}{\tid}{\reference}{\body}
    }
  }
}

\def\embed[src]{
  \<html:embed>[type]{text/html}[src]{\src}{}
}

\def\table[body]{
  \<html:table>{\body}
}
\def\tr[body]{
  \<html:tr>{\body}
}
\def\td[body]{
  \<html:td>{\body}
}
\def\th[body]{
  \<html:th>{\body}
}

% Spec-table cells that never wrap. A number like "9.0 × 10^11" broken across
% two lines reads as two numbers, so data cells are pinned while the \th
% headers are left free to wrap — the long header is what should absorb the
% narrowness, not the value under it. Pair with \scrolltable: pinning cells can
% push the table past the 90ex measure, and a plain <table> sized to its
% content drags the whole article sideways rather than scrolling itself.
\def\ntd[body]{
  \<html:td>[style]{white-space: nowrap;}{\body}
}
\def\scrolltable[body]{
  \<html:div>[style]{
    overflow-x: auto;
    max-width: 100\%;
  }{
    \<html:table>{\body}
  }
}

% The section break: a 2px neutral rule — the palette's hairline, the same one
% a \remark draws — with a lot of air around it. An \hr is the heaviest break
% a page has short of a new heading, and the space is most of what says so —
% the line itself stays a hairline so it reads as a pause rather than a border.
%
% Styled inline here rather than left to the theme's bare `hr` rule, which is
% where it used to live, because that rule now exists only to catch an <hr>
% this macro did not emit (a \md block's markdown can produce one). The two
% carry the same values; change them together.
\def\hr{
  \<html:hr>[style]{
    margin: 2.5rem 0 2rem;
    border: 0;
    border-top: 2px solid rgb(\cal-neutral-rule);
    height: 0;
    background: none;
  }{}
}

% Dense ruled table for protocol state-transition tables (rows = states,
% columns = events). Four things a bare \table cannot do:
%
%   - Fit. A dozen event columns will not sit inside the 90ex measure on their
%     own, and a plain <table> sized to its content pushes the whole article
%     sideways rather than scrolling itself — the failure display math has an
%     overflow box for in style.css. Two moves make it fit: the table is
%     width: 100%, so auto layout wraps cells to the measure instead of
%     growing past it, and the column headers are rotated (\gvth) so a label
%     like "Data from Owner" no longer sets a floor under its column's width.
%     Header length and column width are the whole problem — the cells under
%     those headers say "-/M". The overflow box stays as a fallback for
%     viewports too narrow for even the wrapped table (i.e. phones).
%   - Rule every cell. A grid this dense is unreadable without borders, and
%     borders on \td would land on every other table on the site.
%   - Say "impossible". \gna shades a cell the way the coherence literature
%     does, because "this event cannot occur in this state" and "not filled in
%     yet" are different claims and a blank cell conflates them.
%   - Distinguish the two header axes. \gvth is the rotated column header;
%     \gth is a row's leading state label, upright.
%
% Colors are rgb() and the percent is escaped: an unescaped # opens math and a
% bare % opens a comment, so #ccc and 100% silently render as "ccc" and "100".
%
% Usage: \gridtable{ \tr{\gth{}\gvth{load}...} \tr{\gth{I}\gtd{...}\gna} ... }
\def\gridtable[body]{
  \<html:div>[style]{
    overflow-x: auto;
    max-width: 100\%;
    margin-bottom: 1em;
  }{
    \<html:table>[style]{
      width: 100\%;
      border-collapse: collapse;
      font-size: 0.72em;
      line-height: 1.25;
      margin-bottom: 0;
    }{\body}
  }
}
\def\gvth[body]{
  \<html:th>[style]{
    border: 1px solid rgb(200, 200, 200);
    padding: 4px 2px;
    text-align: left;
    vertical-align: bottom;
    font-family: var(--sans);
    font-weight: 600;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }{\body}
}
\def\gth[body]{
  \<html:th>[style]{
    border: 1px solid rgb(200, 200, 200);
    padding: 2px 5px;
    text-align: left;
    vertical-align: top;
    font-family: var(--sans);
    font-weight: 600;
    white-space: nowrap;
  }{\body}
}
\def\gtd[body]{
  \<html:td>[style]{
    border: 1px solid rgb(200, 200, 200);
    padding: 2px 5px;
    vertical-align: top;
    text-align: left;
  }{\body}
}
\def\gna{
  \<html:td>[style]{
    border: 1px solid rgb(200, 200, 200);
    padding: 2px 5px;
    background-color: rgba(0, 128, 128, 0.12);
  }{}
}

% Syntax-highlighted code block. Wraps a \verb body in <pre><code
% class="language-<lang>"> so highlight.js (vendored in theme/, run on load
% from tree.xsl) can tokenize it; token colors live in theme/style.css. The
% body must still be \verb<<<|...<<< so backslashes/braces pass through raw.
% Usage:  \codeblock{lua}{\verb<<<|  ...code...  <<<}
% Languages: the hljs core bundle (bash, c, cpp, python, lua, rust, js, ts,
% json, yaml, sql, go, java, ...). Unknown/blank lang → hljs auto-detects.
\def\codeblock[lang][body]{\<html:pre>{\<html:code>[class]{language-\lang}{\body}}}

% Same as \codeblock but with a filename/title bar above the code (rendered by
% the .code-figure / .code-filename rules in theme/style.css). Use when the
% snippet is a named source file.  Usage:
%   \codeblockf{flash_attention.py}{python}{ ...code... }
\def\codeblockf[file][lang][body]{\<html:div>[class]{code-figure}{\<html:div>[class]{code-filename}{\file}\<html:pre>{\<html:code>[class]{language-\lang}{\body}}}}

% Utterances comment thread for a blog post. Wrapped in a .comments div so the
% theme can suppress it whenever the post is transcluded (expanded on an index
% or the home page) and render it only on the post's own page — see the
% html:div[@class='comments'] rule in theme/core.xsl. The argument is the
% utterances issue-term (usually \comments{pathname}; a fixed slug otherwise).
\def\comments[term]{
  \<html:div>[class]{comments}{
    \hr
    \<html:script>[src]{https://utteranc.es/client.js}[repo]{kkanarios32/website-comments}[issue-term]{\term}[theme]{boxy-light}[crossorigin]{anonymous}[async]{}{}
  }
}

% Buttondown subscribe form. Deliberately script-free: it is a plain POST, so
% it works with no embed script and nothing to block. Submitting navigates to
% Buttondown's own confirmation page.
%
% `kanarios` is the Buttondown newsletter username; the endpoint 404s if it
% ever changes. Rendering is guarded in theme/core.xsl so the form appears
% only on its own page, never in a transclusion or hover-preview.
%
% Not a card. The block itself carries no fill, no border, and no enclosure of
% any kind — every earlier version that boxed the whole thing read as an embed,
% because nothing else in the running text is boxed. What is enclosed is the
% two controls, which is the opposite case: a field and its submit are the one
% place on the page where an outline is the honest signal, since it says where
% you may type and how far the click target extends.
%
% The divider is a 7.8em stub, not an \hr. A full-width rule here is a section
% break, and this is not a new section — it is a footer ask hanging off the end
% of one. A short rule set at the left margin reads as an ornament: it separates
% without claiming the page has moved on. That also settles the old complaint
% that a second full-width rule near the listings turned the bottom of the page
% into ruled notepaper. It is a div rather than a ::before because this file is
% where the styling belongs and a pseudo-element cannot be written inline.
%
% The field is a fixed 240px and explicitly refuses to grow. Left flexible it
% filled the column, which puts a full-width box a few centimetres below the
% page's other rules — the eye reads that as a second divider well before it
% reads it as an input — and it stranded `Subscribe` against the right margin,
% far from the field it submits. Proximity is what makes the two read as one
% control. `max-width: 100%` is the phone case, where 240px can exceed the
% measure.
%
% The heading is a label, not a title. Sans, small, tracked, uppercase, and in
% the neutral ink: the same register as the TOC rail and the metadata line, so
% it reads as apparatus at the foot of the page rather than as another section
% competing with `Research` and `About this website` above it. It stays a real
% <h1> carrying <a class="slug">, the same markup tree.xsl emits for a subtree
% heading, so the slug keeps its own styling; the slug doubles as the feed link
% — [rss] points at the Atom feed, which is the other thing a subscribe block
% should be offering. The heading's inline letter-spacing and text-transform
% inherit into that anchor, so both are switched back off on it.
%
% Sizes are in em, never rem. The body font-size is a clamp() that eases from
% 11.5pt to 10.5pt as the viewport narrows, and rem is measured against the
% root, which that clamp does not touch — a rem-sized block would sit at a
% fixed 16px basis while the prose around it shrank. The numbers here are the
% design's rem values converted at the desktop basis (1rem = 1.043em).
%
% The field is drawn in plain neutral grey rather than in \cal-neutral-rule,
% and it is the only thing on the site that is. The palette's hairline is warm
% — it is the same rule a \remark draws, tuned to sit under vellum-toned prose
% — and at the size of a form field, over a fill, that warmth stops reading as
% a grey and starts reading as cream. A control is chrome, not content; it
% wants the neutral.
%
% Both controls declare their own font. That is not a style choice but a repair:
% form controls do not inherit typography from their ancestors, and without it
% the browser dresses them in its own UI font — which is how the button once
% ended up in a typeface used nowhere else on the site. They are sans rather
% than the body serif because a control is chrome. line-height is pinned on
% both, partly so the two boxes come out the same height under `align-items:
% baseline`, and partly because some browsers force `normal` on submit inputs
% regardless of what else is set.
%
% The submit is an outline at rest and a fill on hover, in a slate a notch
% darker than the algorithm accent. Nothing on this page is filled until you
% reach for it, which is the right weight for a footer ask: at rest the button
% is the same hairline-and-text the field beside it is, and it only takes on
% ink once the pointer says the reader is considering it. The field is the
% quieter of the two — its border is a pale grey against the button's slate —
% so the actionable half still reads as the actionable one standing still.
% :hover, :focus, and ::placeholder cannot be expressed inline and live in
% theme/style.css against the .embeddable-buttondown-form class; focus tints
% the field's border to the accent and adds a soft ring, in place of the
% platform's focus outline.
\def\subscribe{
  \<html:div>[class]{subscribe-block}[style]{margin: 2.3em 0 1em 0;}{
   \<html:div>[style]{
    width: 7.8em;
    height: 1px;
    background-color: rgb(\cal-neutral-rule);
    margin-bottom: 1.3em;
   }{}
   \<html:h1>[style]{
    display: block;
    margin: 0 0 0.57em 0;
    font-family: var(--sans);
    font-size: 0.71em;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgb(\cal-neutral);
   }{Subscribe by email \<html:a>[class]{slug}[href]{/0002/atom.xml}[style]{letter-spacing: 0; text-transform: none;}{[rss]}}
   \<html:p>[style]{margin: 0 0 1.04em 0; font-size: 0.96em;}{New posts in full, whenever I publish. Nothing else.}
   \<html:form>[class]{embeddable-buttondown-form}[method]{post}[action]{https://buttondown.com/api/emails/embed-subscribe/kanarios}[style]{
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6em;
   }{
    \<html:input>[type]{email}[name]{email}[placeholder]{you@example.com}[required]{required}[style]{
     flex: 0 0 auto;
     width: 240px;
     max-width: 100\%;
     padding: 0.53em 0.76em;
     border: 1px solid rgb(229, 229, 227);
     border-radius: 3px;
     background-color: transparent;
     color: inherit;
     font-family: var(--sans);
     font-size: 0.89em;
     line-height: 1.35;
    }{}
    \<html:input>[type]{hidden}[name]{embed}[value]{1}{}
    \<html:input>[type]{submit}[value]{Subscribe}[style]{
     flex: 0 0 auto;
     padding: 0.53em 1.06em;
     border: 1px solid rgb(51, 64, 90);
     border-radius: 3px;
     background-color: transparent;
     color: rgb(51, 64, 90);
     font-family: var(--sans);
     font-size: 0.89em;
     line-height: 1.35;
     cursor: pointer;
     transition: background-color 120ms ease, color 120ms ease;
    }{}
   }
  }
}

% The one notice that predates the palette and used to be spelled in #hex —
% a bright nursery green on a mint field, which on a page of muted callouts
% was the loudest thing in the forest. Same sage as \solution now: a stub is
% the same gesture, something not yet worked out.
\def\stub{
 \<html:div>[class]{stub-notice}[style]{
  margin: 1.1rem 0;
  padding: 0.1rem 0 0.1rem 0.9rem;
  border-left: 2px solid rgb(\cal-example);
  color: rgb(\cal-example);
  font-style: italic;
  }{🌱 Stub — this concept is referenced but not yet written.}
}

\alloc\base/tex-preamble

\def\latex[body]{
  \tex{\latex-preamble}{\body}
}

\def\example[body]{\callout{rgb(\cal-example)}{rgb(\cal-example-tint)}{Example.}{\body}}

% Folded, like a card's answer and an exercise's solution — a proof is the
% second half of a statement, and a page of theorems is worth more if you can
% read the claims and try one before the argument is on screen. The label is
% the control; the grey frame stays visible so the proof is obviously there.
\def\proof[body]{\foldcallout{rgb(\cal-neutral)}{rgb(\cal-neutral-tint)}{Proof}{\body}}

\def\md[body]{\<html:div>[class]{markdownit grace-loading}{\body}}

\def\block[tit][body]{%
    \subtree{%
      \title{\tit}
      \body
    }
}

\def\mdblock[t][body]{\block{\t}{\md{\body}}}

\def\remark[body]{\calloutbare{rgb(\cal-neutral)}{rgb(\cal-neutral-rule)}{Remark.}{\body}}

\def\notation[body]{\calloutbare{rgb(\cal-neutral)}{rgb(\cal-neutral-rule)}{Notation.}{\body}}

\def\claim[body]{\callout{rgb(\cal-claim)}{rgb(\cal-claim-tint)}{Claim.}{\body}}

\def\question[body]{\callout{rgb(\cal-question)}{rgb(\cal-question-tint)}{Question.}{\body}}

% Folded for the same reason \proof is: an answer sitting open under its
% \question answers it for you. The teal is kept so the pair still reads as a
% question-and-answer rather than as another card.
\def\answer[body]{\foldcallout{rgb(\cal-question)}{rgb(\cal-question-tint)}{Answer}{\body}}

\def\problem[body]{\callout{rgb(\cal-problem)}{rgb(\cal-problem-tint)}{Problem.}{\body}}

% Procedure / pseudocode block. Keeps the old \iblock blue as its identity.
\def\algorithm[body]{\callout{rgb(\cal-algorithm)}{rgb(\cal-algorithm-tint)}{Algorithm.}{\body}}

% A stated objective — what we are trying to achieve.
\def\goal[body]{\callout{rgb(\cal-example)}{rgb(\cal-example-tint)}{Goal.}{\body}}

\def\idea[body]{\callout{rgb(\cal-example)}{rgb(\cal-example-tint)}{Idea.}{\body}}

% A highlighted key takeaway / "aha".
\def\insight[body]{\callout{rgb(\cal-example)}{rgb(\cal-example-tint)}{Insight.}{\body}}

\def\section[tit][body]{
  \subtree{
    \title{\tit}
    \body
  }
}

\def\card[taxa][name][body]{\subtree{\taxon{\taxa}\note{\name}{\body}}}

% The free-standing solution — a worked problem outside a solution manual,
% where \exercise's pink \foldbox is not in play. Folded, and green rather than
% pink, so the two never collide on one page.
\def\solution[body]{\foldcallout{rgb(\cal-problem)}{rgb(\cal-problem-tint)}{Solution}{\body}}

\def\tdtask[id][body]{\li{\body}}
\def\tdtaskx[id][body]{\li{\<html:s>{\body}}}

% The fold-out box: the withheld half of a self-test. A card's \prompt{answer}
% and an exercise's solution both wear it, because they are the same gesture —
% a prompt to attempt the recall or the derivation first.
%
% Not \foldcallout, though the shape is identical, because the label is doing
% a different job. \proof, \answer and \solution name a category — the label
% was already there, bold and colored, before it could be clicked, and taking
% the color away would demote it. Here the label is only ever "Answer" or
% "Solution": it names nothing the question above it has not already said, and
% it is the second thing to read, not the first. A bold colored label on a box
% of the same color says the opposite, and says it twice. So it stays the
% quiet control, which is what it was, and the box carries the color alone.
%
% Parameterized because the box takes its color from what encloses it, not
% from what it contains: an answer inside a Card wears the Card's blue so the
% two read as one object rather than as a warm box sitting inside a cool one.
% \foldbox is the free-standing default, in clay — an exercise's solution has
% no frame around it, so it supplies its own warmth.
\def\foldboxas[accent][tint][t][body]{
  \callout{\accent}{\tint}{}{\foldoutas{\foldout-control}{\t}{\body}}
}

\def\foldbox[t][body]{
  \foldboxas{rgb(\cal-question)}{rgb(\cal-question-tint)}{\t}{\body}
}

% Both sides of a spaced-repetition card. A card tree (trees/cards/) is
% \taxon{Card} with \title{<name>} and this \prompt{<question>}{<answer>} as
% its body. A card is only worth rereading if you can attempt the recall before
% seeing the answer, so a page of cards has to read as a self-test rather than
% a transcript; folding also lets a concept note transclude the cards that test
% it without the answers filling the page.
%
% Structured exactly like \exercise, and for the same reason. The question used
% to live in the \title, which read fine as a line in a list and badly as a
% page: a Forester title is a heading, and a heading is set bold, so a
% three-line question about arithmetic intensity arrived as three lines of bold
% — shouting a thing the reader has not been asked to do anything with yet. A
% question is prose. It wants to be read at prose weight, under a heading that
% says what the card is about.
%
% So the \title is now a name, in the sense \exercise means it: the idea the
% card turns on, not the task. That is authorial work, and it pays for itself
% twice — it is what makes a deck scannable, and it is what lets a concept note
% link a specific card in prose rather than quoting its question.
%
% The tree id is the card's stable identity and scripts/anki-sync mirrors
% \prompt's first argument -> Front and its second -> Back, writing the note id
% back as \meta{anki}{...}. The \title is deliberately not synced: Anki's front
% has to be the question, and a name would be useless on a flashcard. Sync
% reads the \prompt{...}{...} source rather than the rendered output, so
% presentation here is free to change without touching Anki.
%
% The frame around a card is not here but in theme/style.css, keyed on
% [data-taxon="Card"] — it has to enclose the heading, which is emitted from
% frontmatter and so is out of reach of anything the body can wrap. The answer
% takes that same blue, a shade stronger so it still reads as its own box
% against the frame's tint: the two are one object, and a card whose answer
% wore a different accent read as a callout that had wandered in.
\def\prompt[front][back]{
  \p{\front}
  \foldboxas{rgb(\cal-algorithm)}{rgb(\cal-algorithm-tint)}{Answer}{\back}
}

% ── Solution manuals ────────────────────────────────────────────────────────
%
% A solution manual (914H lists them) is a book, so it is written like one:
%
%   \subtree[sutton-ch2]{
%     \title{Multi-armed Bandits}
%     \meta{number}{2}
%     \exercise{2.1}{Greedy action frequency}{
%       ...the question, restated...
%     }{
%       ...the worked solution...
%     }
%   }
%
% The chapter is a bare \subtree with an explicit id rather than \section, and
% the id is load-bearing twice over. It gives the chapter a stable URL, so a
% concept note can link the chapter it was drawn from; and it makes the
% chapter a real parent, which is what stops every exercise heading from being
% prefixed with the manual's own title and a chevron. Forester prepends that
% ancestor path whenever a subtree's designated parent differs from the
% enclosing scope, and only an id'd subtree can be a designated parent — an
% anonymous \section leaves its children pointing at the root. The id cannot
% be wrapped in a macro of its own: \subtree's address is parsed as a literal,
% so it never sees a macro argument. Use book-scoped ids: sutton-ch2, ostep-ch5.
%
% \exercise renders as "Exercise 2.1. Greedy action frequency" with the
% question visible underneath and the solution folded into a \foldbox — the
% same pink box a card's answer gets, for the same reason. That split is the
% whole point: a manual should be readable as a problem set — you can scan
% every question, and re-derive one before you look — which the old format made
% impossible, since collapsing an exercise hid its question along with its
% answer, leaving a page of bare citation keys.
%
% The number is passed as \meta{number} rather than baked into the title so
% the theme sets it in the taxon slot, exactly where "Definition 1.2." puts
% its number (see tree-taxon-with-number in theme/tree.xsl). Auto-numbering
% cannot be used, at either level: a manual covers chapters 2, 3, 4, 8, 9 and
% solves 2.1, 2.2, 2.4, 2.6 — the book's numbering, gaps and all, is the whole
% identity of an entry, and counting positions would quietly renumber it. So
% chapters carry \meta{number}{2} by hand too. On the exercise, toc/numbered
% are off for the same reason — an exercise must not renumber the chapters
% around it, and forty exercises would bury a chapter list.
%
% The name is required and is the one piece of real authorial work here: it
% is what makes a manual scannable and what makes an exercise worth linking
% to from a concept note. Name the idea the exercise turns on, not the task
% ("Greedy action frequency", never "Compute the probability").
\def\exercise[num][name][question][soln]{
  \scope{
    \put\transclude/toc{false}
    \put\transclude/numbered{false}
    \put\transclude/expanded{true}
    \subtree{
      \taxon{Exercise}
      \meta{number}{\num}
      \title{\name}
      \question
      \foldbox{Solution}{\soln}
    }
  }
}

% An exercise stated but not yet worked. It keeps its entry rather than being
% dropped: the gap is part of the worklist, and the book's own numbering
% advertises it anyway. No disclosure — there is nothing behind it to spoil,
% and a triangle that opens onto "Not yet worked" wastes a click.
\def\exerciseunsolved[num][name][question]{
  \scope{
    \put\transclude/toc{false}
    \put\transclude/numbered{false}
    \put\transclude/expanded{true}
    \subtree{
      \taxon{Exercise}
      \meta{number}{\num}
      \title{\name}
      \question
      \<html:p>[style]{color: rgba(0, 0, 0, 0.5); font-style: italic;}{Not yet worked.}
    }
  }
}

% What I expected before running the code, kept beside what actually happened.
% Systems exercises are only worth doing this way — the prediction is the
% experiment, and a wrong one is the part worth rereading later.
\def\prediction[body]{\callout{rgb(\cal-claim)}{rgb(\cal-claim-tint)}{Prediction.}{\body}}
