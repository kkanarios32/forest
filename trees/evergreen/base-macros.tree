\tag{public}

\title{basic macros}
\import{latex-preamble}

\xmlns:html{http://www.w3.org/1999/xhtml}

\def\nowrap[body]{\<html:span>[style]{white-space: nowrap}{\body}}

\def\#[body]{
  \startverb#\stopverb\body
}

\def\smile[body]{
  \startverb:)\stopverb\body
}
\def\colblock[body]{
 \<html:div>[class]{jms-indent-block}[style]{
  margin-left: 1em;
  margin-bottom: 1em;
  border-left: 4px solid black;
  padding-left: 12px;
  background-color: whitesmoke;
  }{\body}
}

\def\quote[body]{
 \<html:blockquote>[class]{jms-quote}[style]{
  margin: 1em 0 1em 0.25em;
  padding: 0.6em 1.1em 0.6em 1.3em;
  border-left: 4px solid rgba(0, 0, 0, 0.25);
  border-radius: var(--radius);
  background-color: rgba(0, 0, 0, 0.035);
  font-style: italic;
  color: rgba(0, 0, 0, 0.85);
  }{\body}
}

\def\quotes[body][source]{
 \<html:blockquote>[class]{jms-quote}[style]{
  margin: 1em 0 1em 0.25em;
  padding: 0.6em 1.1em 0.6em 1.3em;
  border-left: 4px solid rgba(0, 0, 0, 0.25);
  border-radius: var(--radius);
  background-color: rgba(0, 0, 0, 0.035);
  font-style: italic;
  color: rgba(0, 0, 0, 0.85);
  }{\body\<html:div>[style]{
   margin-top: -0.5em;
   font-style: normal;
   font-size: 0.9em;
   text-align: right;
   color: rgba(0, 0, 0, 0.55);
  }{— \source}}
}

% Callout asides (Problem./Question./Remark./…). A tinted, left-bordered block
% in the \quote house style, led by a bold colored label. These render inline
% wherever they appear (including inside \li) rather than as their own \subtree,
% so they need no taxon and take no TOC/numbering. \accent tints the border and
% label; \tint is the (much lighter) background. Pass rgba(...) colors, never
% #hex — Forester eats a bare #.
\def\callout[accent][tint][label][body]{
 \<html:div>[class]{jms-callout}[style]{
  margin: 1em 0 1em 0.25em;
  padding: 0.5em 1.1em 0.5em 1.2em;
  border-left: 4px solid \accent;
  border-radius: var(--radius);
  background-color: \tint;
  }{\<html:span>[style]{font-weight: 600; color: \accent;}{\label} \body}
}

\def\irow[body]{
 \<html:div>[class]{jms-indent-row}[style]{min-height: 1em}{\body}
}

\def\mark[body]{\<html:mark>{\body}}

% LaTeX-style run-in heading. \paragraph{Word} renders a bold sans lead-in
% label with a trailing period — "Word." — after which the sentence continues
% inline. Replaces the bold-label-with-colon idiom so the label pops in the
% sans (var(--sans)) against the serif body. Pass the label WITHOUT punctuation;
% the macro adds the period. The argument may hold links/math (\paragraph{[[ID]]}).
\def\paragraph[head]{\<html:strong>[style]{font-family: var(--sans); font-weight: 500;}{\head.}}

\def\lsquare{\startverb[\stopverb}
\def\rsquare{\startverb]\stopverb}
\def\lparen{\startverb(\stopverb}
\def\rparen{\startverb)\stopverb}

\def\closed-open[x]{\lsquare\x\rparen}
\def\open-closed[x]{\lparen\x\rsquare}

\def\collapsed[t][body]{
 \scope{
    \put\transclude/toc{false}
    \put\transclude/expanded{false}
    \subtree{
      \title{\t}
      \body
   }
 }
}

% A click-to-expand block: a bare <details> with its label as the control.
%
% This is deliberately NOT a \subtree, which is the obvious way to fold
% something in Forester — \collapsed does exactly that, and it is the right
% tool when the thing being folded is a real section of the document. A proof,
% a solution, an answer is not. Making it a tree gave each one a title, an
% author, a date, an entry in the graph, and — the tell — an ancestor path
% prefix, because Forester prepends the path whenever a subtree's designated
% parent differs from the enclosing scope, and an anonymous \section leaves its
% children pointing at the root. So a proof inside a section rendered as
% "Online Softmax › Proof": the page reintroducing itself, once per proof.
%
% None of that is wanted. What is wanted is a disclosure widget, and HTML has
% one. \<html:...> passes through generically (the html:* template in
% theme/core.xsl), so this emits a real <details> holding nothing but the
% label and the body — no id, no metadata, no ancestor path, no participation
% in backlinks or \query.
%
% The theme hides the browser's own disclosure marker site-wide
% (details>summary::marker), so the triangle has to be built: the class here is
% what .foldout in theme/style.css hangs it on. That rule cannot move into an
% inline style, because the glyph depends on whether the <details> is open, and
% no inline style can see state.
% \sty styles the label, which is also the click target and the thing the
% triangle inherits its color from — so a folded callout hands its accent in
% here and the control comes out looking like the label it replaced, rather
% than like a piece of UI bolted to the box.
\def\foldoutas[sty][t][body]{
  \<html:details>{\<html:summary>{\<html:span>[class]{foldout}[style]{\sty}{\t}}\body}
}

% The quiet control. Sans, below body size, grey: this is the styling for a
% fold whose label names no category — "Answer", "Solution" — and so is pure
% affordance. It has to stay out of the way of the heading above it, which is
% the thing being answered and the thing worth reading first.
\def\foldout-control{font-family: var(--sans); font-size: 11pt; font-weight: 500; color: rgba(0, 0, 0, 0.65);}

% A fold-out with nothing around it: the control, unadorned.
\def\foldout[t][body]{\foldoutas{\foldout-control}{\t}{\body}}

% A callout whose body is withheld behind its own label: the box is drawn from
% the start, and the label doubles as the control that opens it. This is the
% shape every "second half" of something takes here — a card's answer, an
% exercise's solution, a proof — because seeing the frame is what cues the
% attempt at recall or derivation before the contents are on screen.
%
% The label moves into the fold control rather than staying in \callout's own
% label slot, so nothing is printed twice — and it takes the accent with it,
% weight and period and all. A folded Proof and an open Remark sitting on the
% same page should read as the same kind of thing, one of which happens to be
% closed; the only difference is the triangle, which inherits the accent too.
%
% Defined here, immediately after \foldoutas, and not up with \callout: a macro
% body is expanded against the definitions in scope at that point, so a
% reference to a fold-out before its definition leaves the literal text in the
% output. Anything folding a callout must therefore come after both.
\def\foldcallout[accent][tint][label][body]{
  \callout{\accent}{\tint}{}{\foldoutas{font-weight: 600; color: \accent;}{\label.}{\body}}
}

\def\citek[refid]{\let\escape[x]{\x}\<html:span>[class]{link-reference}{[\escape{[\refid]}](\refid)}}

\def\citet[tid][refid]{\let\escape[x]{\x}\<html:span>[class]{link-reference}[tid]{\tid}[refid]{\refid}{[\escape{[\refid, \tid]}](\refid)}}

\def\note[name][body]{
    \title{\name}
    \body
}


\def\refnote[name][reference][body]{
  \note{\name \citek{\reference}}{\body}
}

\def\refnotet[name][tid][reference][body]{%
  \title{\name \citet{\tid}{\reference}}
  \body
}

\def\refcard[taxa][name][reference][body]{\subtree{\taxon{\taxa}\refnote{\name}{\reference}{\body}}}

\def\refcardt[taxa][name][tid][reference][body]{
  \scope{
    \put\transclude/toc{false}
    \put\transclude/numbered{false}
    \subtree{
      \taxon{\taxa}\refnotet{\name}{\tid}{\reference}{\body}
    }
  }
}

\def\embed[src]{
  \<html:embed>[type]{text/html}[src]{\src}{}
}

\def\table[body]{
  \<html:table>{\body}
}
\def\tr[body]{
  \<html:tr>{\body}
}
\def\td[body]{
  \<html:td>{\body}
}
\def\th[body]{
  \<html:th>{\body}
}
\def\hr{
  \<html:hr>{}
}

% Dense ruled table for protocol state-transition tables (rows = states,
% columns = events). Four things a bare \table cannot do:
%
%   - Fit. A dozen event columns will not sit inside the 90ex measure on their
%     own, and a plain <table> sized to its content pushes the whole article
%     sideways rather than scrolling itself — the failure display math has an
%     overflow box for in style.css. Two moves make it fit: the table is
%     width: 100%, so auto layout wraps cells to the measure instead of
%     growing past it, and the column headers are rotated (\gvth) so a label
%     like "Data from Owner" no longer sets a floor under its column's width.
%     Header length and column width are the whole problem — the cells under
%     those headers say "-/M". The overflow box stays as a fallback for
%     viewports too narrow for even the wrapped table (i.e. phones).
%   - Rule every cell. A grid this dense is unreadable without borders, and
%     borders on \td would land on every other table on the site.
%   - Say "impossible". \gna shades a cell the way the coherence literature
%     does, because "this event cannot occur in this state" and "not filled in
%     yet" are different claims and a blank cell conflates them.
%   - Distinguish the two header axes. \gvth is the rotated column header;
%     \gth is a row's leading state label, upright.
%
% Colors are rgb() and the percent is escaped: an unescaped # opens math and a
% bare % opens a comment, so #ccc and 100% silently render as "ccc" and "100".
%
% Usage: \gridtable{ \tr{\gth{}\gvth{load}...} \tr{\gth{I}\gtd{...}\gna} ... }
\def\gridtable[body]{
  \<html:div>[style]{
    overflow-x: auto;
    max-width: 100\%;
    margin-bottom: 1em;
  }{
    \<html:table>[style]{
      width: 100\%;
      border-collapse: collapse;
      font-size: 0.72em;
      line-height: 1.25;
      margin-bottom: 0;
    }{\body}
  }
}
\def\gvth[body]{
  \<html:th>[style]{
    border: 1px solid rgb(200, 200, 200);
    padding: 4px 2px;
    text-align: left;
    vertical-align: bottom;
    font-family: var(--sans);
    font-weight: 600;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }{\body}
}
\def\gth[body]{
  \<html:th>[style]{
    border: 1px solid rgb(200, 200, 200);
    padding: 2px 5px;
    text-align: left;
    vertical-align: top;
    font-family: var(--sans);
    font-weight: 600;
    white-space: nowrap;
  }{\body}
}
\def\gtd[body]{
  \<html:td>[style]{
    border: 1px solid rgb(200, 200, 200);
    padding: 2px 5px;
    vertical-align: top;
    text-align: left;
  }{\body}
}
\def\gna{
  \<html:td>[style]{
    border: 1px solid rgb(200, 200, 200);
    padding: 2px 5px;
    background-color: rgba(0, 128, 128, 0.12);
  }{}
}

% Syntax-highlighted code block. Wraps a \verb body in <pre><code
% class="language-<lang>"> so highlight.js (vendored in theme/, run on load
% from tree.xsl) can tokenize it; token colors live in theme/style.css. The
% body must still be \verb<<<|...<<< so backslashes/braces pass through raw.
% Usage:  \codeblock{lua}{\verb<<<|  ...code...  <<<}
% Languages: the hljs core bundle (bash, c, cpp, python, lua, rust, js, ts,
% json, yaml, sql, go, java, ...). Unknown/blank lang → hljs auto-detects.
\def\codeblock[lang][body]{\<html:pre>{\<html:code>[class]{language-\lang}{\body}}}

% Same as \codeblock but with a filename/title bar above the code (rendered by
% the .code-figure / .code-filename rules in theme/style.css). Use when the
% snippet is a named source file.  Usage:
%   \codeblockf{flash_attention.py}{python}{ ...code... }
\def\codeblockf[file][lang][body]{\<html:div>[class]{code-figure}{\<html:div>[class]{code-filename}{\file}\<html:pre>{\<html:code>[class]{language-\lang}{\body}}}}

% Utterances comment thread for a blog post. Wrapped in a .comments div so the
% theme can suppress it whenever the post is transcluded (expanded on an index
% or the home page) and render it only on the post's own page — see the
% html:div[@class='comments'] rule in theme/core.xsl. The argument is the
% utterances issue-term (usually \comments{pathname}; a fixed slug otherwise).
\def\comments[term]{
  \<html:div>[class]{comments}{
    \hr
    \<html:script>[src]{https://utteranc.es/client.js}[repo]{kkanarios32/website-comments}[issue-term]{\term}[theme]{boxy-light}[crossorigin]{anonymous}[async]{}{}
  }
}

% Buttondown subscribe form. Deliberately script-free: it is a plain POST, so
% it works with no embed script and nothing to block. Submitting navigates to
% Buttondown's own confirmation page.
%
% `kanarios` is the Buttondown newsletter username; the endpoint 404s if it
% ever changes. Rendering is guarded in theme/core.xsl so the form appears
% only on its own page, never in a transclusion or hover-preview.
%
% Not a card. Every earlier version enclosed this in a bordered, tinted,
% rounded panel, and each round of toning that panel down only made it a
% quieter version of the wrong thing: nothing else on a page here carries a
% fill or a border, so any box at all reads as an embed. The block sits in the
% ordinary flow, separated by its heading and the space above it.
%
% It carries no rule of its own either. There is already an \hr above the
% listings, so adding a second one put three horizontal lines within a short
% stretch of page — four counting the field's own baseline — and the bottom of
% the page started to read as ruled notepaper. A heading plus whitespace
% separates perfectly well once the surrounding page has any dividers at all.
%
% The field is a fixed 200px and explicitly refuses to grow. Left flexible it
% filled the column, which put a full-width 1px line a few centimetres below a
% full-width \hr — the eye reads that as a second divider well before it reads
% it as an input — and it stranded `Subscribe` against the right margin, far
% from the field it submits. Proximity is what makes the two read as one
% control.
%
% Everything inherits. There is no font declaration in here at all: the heading
% is a real <h1>, so the theme's own heading rules style it exactly as they
% style `About this website` or `Research`, and the prose picks up the body
% serif. The sole exception is `font: inherit` on the two inputs, which is not
% a font choice but a repair — form controls do not inherit typography from
% their ancestors, and without it the browser dresses them in its own UI font.
% That was how the button ended up in a typeface used nowhere else on the site.
%
% The heading follows the section convention rather than imitating it. Emitting
% <h1> + <a class="slug"> is the same markup tree.xsl generates for a subtree
% heading, so it inherits `details h1` and `.slug` and cannot drift if that
% convention changes. The slug doubles as the feed link — [rss] points at the
% Atom feed, which is the other thing a subscribe block should be offering.
%
% Underlines, not enclosures. The page's whole interaction language is
% underlined text: local links, slugs, the resume link. So the email field is a
% baseline rule and the submit is an underlined word, both of which read as
% part of that system where a rounded outlined control does not. :hover and
% :focus cannot be expressed inline and live in theme/style.css against the
% .embeddable-buttondown-form class; the hover tint there is the same one
% a.slug and .link already use.
%
% Both underlines are border-bottoms, and the two controls carry identical
% padding and line-height, on purpose. The submit originally used
% text-decoration with no padding, which left it sitting visibly high:
% align-items: baseline matches text baselines, but each rule is offset from
% its baseline by that control's own padding-bottom, so unequal padding meant
% unequal rules — and a text-decoration underline rides just under the glyphs
% while a border sits at the bottom of the box, compounding it. padding-bottom
% is in px rather than em so the two cannot drift apart if either control's
% font-size is ever touched, and line-height is pinned because some browsers
% force `normal` on submit inputs regardless of `font: inherit`. The submit's
% rule is currentColor against the field's 40% black, so the actionable half
% still reads as the darker one.
\def\subscribe{
  \<html:div>[class]{subscribe-block}[style]{margin: 1.6em 0 1em 0;}{
    \hr
   \<html:h1>{Subscribe by email \<html:a>[class]{slug}[href]{/0002/atom.xml}{[rss]}}
   \<html:p>[style]{margin: 0.4em 0 0.8em 0;}{New posts in full, whenever I publish. Nothing else.}
   \<html:form>[class]{embeddable-buttondown-form}[method]{post}[action]{https://buttondown.com/api/emails/embed-subscribe/kanarios}[style]{
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 18px;
   }{
    \<html:input>[type]{email}[name]{email}[placeholder]{you@example.com}[required]{required}[style]{
     flex: 0 0 auto;
     width: 200px;
     padding: 0.15em 0.1em 4px 0.1em;
     border: none;
     border-bottom: 1px solid rgba(0, 0, 0, 0.4);
     border-radius: 0;
     background-color: transparent;
     font: inherit;
     line-height: inherit;
    }{}
    \<html:input>[type]{hidden}[name]{embed}[value]{1}{}
    \<html:input>[type]{submit}[value]{Subscribe}[style]{
     flex: 0 0 auto;
     padding: 0.15em 0.1em 4px 0.1em;
     border: none;
     border-bottom: 1px solid currentColor;
     border-radius: 0;
     background-color: transparent;
     color: inherit;
     font: inherit;
     line-height: inherit;
     cursor: pointer;
    }{}
   }
  }
}

\def\stub{
 \<html:div>[class]{stub-notice}[style]{
  margin: 0.5em 0;
  padding: 8px 12px;
  border-left: 4px solid #7cb342;
  background-color: #f1f8e9;
  color: #33691e;
  font-style: italic;
  }{🌱 Stub — this concept is referenced but not yet written.}
}

\alloc\base/tex-preamble

\def\latex[body]{
  \tex{\latex-preamble}{\body}
}

\def\example[body]{\callout{rgba(60, 90, 180, 0.8)}{rgba(60, 90, 180, 0.05)}{Example.}{\body}}

% Folded, like a card's answer and an exercise's solution — a proof is the
% second half of a statement, and a page of theorems is worth more if you can
% read the claims and try one before the argument is on screen. The label is
% the control; the grey frame stays visible so the proof is obviously there.
\def\proof[body]{\foldcallout{rgba(0, 0, 0, 0.4)}{rgba(0, 0, 0, 0.03)}{Proof}{\body}}

\def\md[body]{\<html:div>[class]{markdownit grace-loading}{\body}}

\def\block[tit][body]{%
    \subtree{%
      \title{\tit}
      \body
    }
}

\def\mdblock[t][body]{\block{\t}{\md{\body}}}

\def\remark[body]{\callout{rgba(90, 90, 110, 0.7)}{rgba(90, 90, 110, 0.05)}{Remark.}{\body}}

\def\notation[body]{\callout{rgba(70, 100, 150, 0.75)}{rgba(70, 100, 150, 0.05)}{Notation.}{\body}}

\def\claim[body]{\callout{rgba(140, 60, 170, 0.8)}{rgba(140, 60, 170, 0.05)}{Claim.}{\body}}

\def\question[body]{\callout{rgba(200, 130, 0, 0.9)}{rgba(200, 130, 0, 0.06)}{Question.}{\body}}

% Folded for the same reason \proof is: an answer sitting open under its
% \question answers it for you. The teal is kept so the pair still reads as a
% question-and-answer rather than as another card.
\def\answer[body]{\foldcallout{rgba(0, 140, 120, 0.9)}{rgba(0, 140, 120, 0.06)}{Answer}{\body}}

\def\problem[body]{\callout{rgba(200, 55, 45, 0.85)}{rgba(200, 55, 45, 0.06)}{Problem.}{\body}}

% Procedure / pseudocode block. Keeps the old \iblock blue as its identity.
\def\algorithm[body]{\callout{rgba(0, 100, 255, 0.7)}{rgba(0, 100, 255, 0.05)}{Algorithm.}{\body}}

% A stated objective — what we are trying to achieve.
\def\goal[body]{\callout{rgba(190, 50, 130, 0.85)}{rgba(190, 50, 130, 0.06)}{Goal.}{\body}}

\def\idea[body]{\callout{rgba(190, 50, 130, 0.85)}{rgba(190, 50, 130, 0.06)}{💡 Idea.}{\body}}

% A highlighted key takeaway / "aha".
\def\insight[body]{\callout{rgba(0, 160, 175, 0.9)}{rgba(0, 160, 175, 0.06)}{💡 Insight.}{\body}}

\def\section[tit][body]{
  \subtree{
    \title{\tit}
    \body
  }
}

\def\card[taxa][name][body]{\subtree{\taxon{\taxa}\note{\name}{\body}}}

% The free-standing solution — a worked problem outside a solution manual,
% where \exercise's pink \foldbox is not in play. Folded, and green rather than
% pink, so the two never collide on one page.
\def\solution[body]{\foldcallout{rgba(40, 150, 80, 0.9)}{rgba(40, 150, 80, 0.06)}{Solution}{\body}}

\def\tdtask[id][body]{\li{\body}}
\def\tdtaskx[id][body]{\li{\<html:s>{\body}}}

% The pink fold-out: the withheld half of a self-test. A card's
% \prompt{answer} and an exercise's solution both wear it, and they wear the
% same pink deliberately, because they are the same gesture — a prompt to
% attempt the recall or the derivation first. The pink is \goal/\idea's, the
% one accent in the palette not already spoken for by a callout that can sit
% next to a solution.
%
% Not \foldcallout, though the shape is identical, because the label is doing
% a different job. \proof, \answer and \solution name a category — the label
% was already there, bold and colored, before it could be clicked, and taking
% the color away would demote it. Here the label is only ever "Answer" or
% "Solution": it names nothing the question above it has not already said, and
% it is the second thing to read, not the first. Bold pink on a pink box says
% the opposite, and says it twice. So it stays the quiet control, which is
% what it was, and the box carries the color on its own.
\def\foldbox[t][body]{
  \callout{rgba(190, 50, 130, 0.85)}{rgba(190, 50, 130, 0.06)}{}{\foldoutas{\foldout-control}{\t}{\body}}
}

% Both sides of a spaced-repetition card. A card tree (trees/cards/) is
% \taxon{Card} with \title{<name>} and this \prompt{<question>}{<answer>} as
% its body. A card is only worth rereading if you can attempt the recall before
% seeing the answer, so a page of cards has to read as a self-test rather than
% a transcript; folding also lets a concept note transclude the cards that test
% it without the answers filling the page.
%
% Structured exactly like \exercise, and for the same reason. The question used
% to live in the \title, which read fine as a line in a list and badly as a
% page: a Forester title is a heading, and a heading is set bold, so a
% three-line question about arithmetic intensity arrived as three lines of bold
% — shouting a thing the reader has not been asked to do anything with yet. A
% question is prose. It wants to be read at prose weight, under a heading that
% says what the card is about.
%
% So the \title is now a name, in the sense \exercise means it: the idea the
% card turns on, not the task. That is authorial work, and it pays for itself
% twice — it is what makes a deck scannable, and it is what lets a concept note
% link a specific card in prose rather than quoting its question.
%
% The tree id is the card's stable identity and scripts/anki-sync mirrors
% \prompt's first argument -> Front and its second -> Back, writing the note id
% back as \meta{anki}{...}. The \title is deliberately not synced: Anki's front
% has to be the question, and a name would be useless on a flashcard. Sync
% reads the \prompt{...}{...} source rather than the rendered output, so
% presentation here is free to change without touching Anki.
\def\prompt[front][back]{\p{\front}\foldbox{Answer}{\back}}

% ── Solution manuals ────────────────────────────────────────────────────────
%
% A solution manual (914H lists them) is a book, so it is written like one:
%
%   \subtree[sutton-ch2]{
%     \title{Multi-armed Bandits}
%     \meta{number}{2}
%     \exercise{2.1}{Greedy action frequency}{
%       ...the question, restated...
%     }{
%       ...the worked solution...
%     }
%   }
%
% The chapter is a bare \subtree with an explicit id rather than \section, and
% the id is load-bearing twice over. It gives the chapter a stable URL, so a
% concept note can link the chapter it was drawn from; and it makes the
% chapter a real parent, which is what stops every exercise heading from being
% prefixed with the manual's own title and a chevron. Forester prepends that
% ancestor path whenever a subtree's designated parent differs from the
% enclosing scope, and only an id'd subtree can be a designated parent — an
% anonymous \section leaves its children pointing at the root. The id cannot
% be wrapped in a macro of its own: \subtree's address is parsed as a literal,
% so it never sees a macro argument. Use book-scoped ids: sutton-ch2, ostep-ch5.
%
% \exercise renders as "Exercise 2.1. Greedy action frequency" with the
% question visible underneath and the solution folded into a \foldbox — the
% same pink box a card's answer gets, for the same reason. That split is the
% whole point: a manual should be readable as a problem set — you can scan
% every question, and re-derive one before you look — which the old format made
% impossible, since collapsing an exercise hid its question along with its
% answer, leaving a page of bare citation keys.
%
% The number is passed as \meta{number} rather than baked into the title so
% the theme sets it in the taxon slot, exactly where "Definition 1.2." puts
% its number (see tree-taxon-with-number in theme/tree.xsl). Auto-numbering
% cannot be used, at either level: a manual covers chapters 2, 3, 4, 8, 9 and
% solves 2.1, 2.2, 2.4, 2.6 — the book's numbering, gaps and all, is the whole
% identity of an entry, and counting positions would quietly renumber it. So
% chapters carry \meta{number}{2} by hand too. On the exercise, toc/numbered
% are off for the same reason — an exercise must not renumber the chapters
% around it, and forty exercises would bury a chapter list.
%
% The name is required and is the one piece of real authorial work here: it
% is what makes a manual scannable and what makes an exercise worth linking
% to from a concept note. Name the idea the exercise turns on, not the task
% ("Greedy action frequency", never "Compute the probability").
\def\exercise[num][name][question][soln]{
  \scope{
    \put\transclude/toc{false}
    \put\transclude/numbered{false}
    \put\transclude/expanded{true}
    \subtree{
      \taxon{Exercise}
      \meta{number}{\num}
      \title{\name}
      \question
      \foldbox{Solution}{\soln}
    }
  }
}

% An exercise stated but not yet worked. It keeps its entry rather than being
% dropped: the gap is part of the worklist, and the book's own numbering
% advertises it anyway. No disclosure — there is nothing behind it to spoil,
% and a triangle that opens onto "Not yet worked" wastes a click.
\def\exerciseunsolved[num][name][question]{
  \scope{
    \put\transclude/toc{false}
    \put\transclude/numbered{false}
    \put\transclude/expanded{true}
    \subtree{
      \taxon{Exercise}
      \meta{number}{\num}
      \title{\name}
      \question
      \<html:p>[style]{color: rgba(0, 0, 0, 0.5); font-style: italic;}{Not yet worked.}
    }
  }
}

% What I expected before running the code, kept beside what actually happened.
% Systems exercises are only worth doing this way — the prediction is the
% experiment, and a wrong one is the part worth rereading later.
\def\prediction[body]{\callout{rgba(120, 90, 190, 0.85)}{rgba(120, 90, 190, 0.05)}{Prediction.}{\body}}
