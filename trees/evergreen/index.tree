% A colophon — how this site is built and how it is organised. Useful, but to
% the curious rather than the first-time visitor, so it comes last.
\scope{
  \put\transclude/toc{false}
  \put\transclude/numbered{false}
  \subtree[about]{
    \title{About this website}
    \p{
    This is my [forest](https://www.forester-notes.org/index/index.xml) (shoutout to [[jonmsterling]] who is remarkably helpful). This website functions both as a [personal knowledge management system](https://en.wikipedia.org/wiki/Personal_knowledge_management), where I store my notes in [notebooks](0015), some accompanying solutions in the [solution manuals](914H), and any external resources I have made in [[0004]]. Additionally, I store my thoughts in a variety of consumption mediums. Namely, both long-form and short-form notes / posts can be found in my [blog](0002). I also maintain two weekly posting obligations: a [weeknotes / lifelog](007S) and a [paper of the week](005G). To see what I have been thinking about recently, there is a list of recently modified trees [here](RCNT).
  }
  }
}

\hr

% The listings. One rule decides what belongs here rather than in the prose
% site map above: transclude only what a first-time visitor should see without
% clicking. That is Research, which is why an academic visitor came, and Blog,
% which is what the subscribe box below is selling. Every other derived index —
% notebooks, solution manuals, weeknotes, paper of the week, and the recently
% edited listing — is linked from `About this website` instead. Both of these
% are Datalog queries, so the page keeps updating itself as trees are tagged.
\scope{
  \put\transclude/expanded{false}
  \subtree[bib]{
  \title{Research}
  % A listing, like any other index page: it stays expandable in place, and
  % the papers it lists render as links to their own pages.
  \tag{index}
  \meta{index}{true}
    \query\datalog{
    ?X -:
    {\rel/has-author ?X @{kellenkanarios}}
    {\rel/is-reference ?X}
    {\rel/has-tag ?X '{research}}
    }
  }
  \transclude{0002}
}

% The newsletter ask sits after the listings, not before them, and directly
% under the Blog listing it is selling: by here the reader has seen that there
% is a blog and what has gone into it.
\subscribe
