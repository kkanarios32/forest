\author{kellenkanarios}
\import{base-macros}
\taxon{Theorem}
\title{The type-based fixed-rate code is universal}

\p{
The code constructed above is a universal fixed-rate code, such that #{ \lim_{n\to\infty}\mathbb{P}_{X^{n}\sim P^{n}}(f_{n}(e_{n}(X^{n}))\neq X^{n})=0 } for all #{ P } with #{ H(P)<R }.
}
