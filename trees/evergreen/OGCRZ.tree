\import{base-macros}
\date{2026-05-27T13:15:25Z}
\author{kellenkanarios}
\tag{public}

\title{Flash Attention (Bwd)}

\p{The forward pass of [flash attention](daoFlashAttentionFastMemoryEfficient2022) avoids materializing the #{N \times N} attention matrix by streaming an online softmax. The backward pass has to pull the same trick twice over, because the naive gradient computation wants \em{two} #{N \times N} matrices — #{\mathbf{P}} and #{d\mathbf{P}}. Getting there means first writing down every gradient we need, then finding a way to recompute rather than store each one.}

\notation{
Following the notation in the [original paper](daoFlashAttentionFastMemoryEfficient2022),
##{\mathbf{S} = \mathbf{Q} \mathbf{K}^T, \quad \mathbf{P} = \mathrm{softmax}(\mathbf{S}), \quad \mathbf{O} = \mathbf{P} \mathbf{V},}
where #{\mathbf{Q}, \mathbf{K}, \mathbf{V}, \mathbf{O}} are #{N \times d} and #{\mathbf{S}, \mathbf{P}} are #{N \times N}. For a scalar loss #{\phi} we abbreviate the gradient with respect to any matrix #{\mathbf{X}} as
##{d\mathbf{X} = \frac{\partial \phi}{\partial \mathbf{X}},}
and write #{\mathbf{L}_i} for the softmax denominator of row #{i} saved by the forward pass, so that #{\mathbf{P}_{ij} = \exp(\mathbf{Q}_i \cdot \mathbf{K}_j) / \mathbf{L}_i}.
}

\transclude{4QZE}

\section{Summary}{
\p{\paragraph{Forward pass} Store #{\mathbf{O}} and the softmax denominators #{\mathbf{L}}, both #{O(Nd)}.}
\p{\paragraph{Between the passes} Receive #{d\mathbf{O}} from the layer above (automatic in [JAX](OGCRY)), then precompute #{\mathbf{D}_i = d\mathbf{O}_i \cdot \mathbf{O}_i} in #{O(N)} memory.}
\p{\paragraph{Backward pass} Stream over tiles, recomputing #{\mathbf{P}_{ij}} from #{\mathbf{Q}, \mathbf{K}, \mathbf{L}} and #{d\mathbf{P}_{ij}} from #{d\mathbf{O}, \mathbf{V}} as needed:}
\ol{
  \li{#{d\mathbf{V}_j = \sum_i \mathbf{P}_{ij} d\mathbf{O}_i}, accumulated over query tiles.}
  \li{#{d\mathbf{Q}_i = \sum_j \mathbf{P}_{ij}(d\mathbf{O}_i \cdot \mathbf{V}_j - \mathbf{D}_i)\mathbf{K}_j}, accumulated over key tiles.}
  \li{#{d\mathbf{K}_j = \sum_i \mathbf{P}_{ij}(d\mathbf{O}_i \cdot \mathbf{V}_j - \mathbf{D}_i)\mathbf{Q}_i}, accumulated over query tiles.}
}
\p{Each accumulator is #{O(d)} per row or column, so the whole backward pass stays linear in #{N}.}
}
