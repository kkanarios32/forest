\import{base-macros}
\author{kellenkanarios}
\title{Reduced instruction set computing (RISC)}
\taxon{Definition}
\tag{public}
\p{An ISA with a small set of simple, uniform instructions; explicit load and store; arithmetic only on registers. Each instruction does little but maps cleanly to hardware. PowerPC, MIPS, ARM are RISC.}
