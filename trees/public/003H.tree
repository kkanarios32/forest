\tag{public}

\date{2025-01-27}
\title{Unitary Invariant Matrix Norm}
\taxon{Definition}
\p{
Let #{\mathbf{A}\in\mathbb{R}^{m\times n}.} We say the matrix norm is unitary invariant if ##{\left||\mathbf{A}\right||_{\sharp}\ =\ \left||\mathbf{PAQ}\right||_{\sharp},\quad\forall\ \mathbf{P}\in O(m),\ \mathbf{Q}\in O(n).}
  }
  \p{The two most common examples are both unitary invariant because they depend on #{\mathbf{A}} only through its singular values: the [[3U43]] (#{\|\sigma(\mathbf{A})\|_\infty}) and the [[4M9J]] (#{\|\sigma(\mathbf{A})\|_2}).}

  \transclude{3U43}
  \transclude{4M9J}
