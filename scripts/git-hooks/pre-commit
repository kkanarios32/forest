#!/bin/bash
# Keep notes-log.md in sync with trees/evergreen/ on every commit. This catches
# trees created outside `scripts/new` (e.g. `forester new` directly or an editor
# snippet) and title/date edits to existing trees. Rebuilds the registry and
# stages it if it changed. Never blocks a commit: a registry failure warns only.
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel)

if ! "$ROOT/scripts/registry"; then
  echo "pre-commit: scripts/registry failed; leaving notes-log.md untouched" >&2
  exit 0
fi

# Refresh the local inbox worklist too (gitignored, never staged) so stub /
# transient trees created outside scripts/new still show up.
"$ROOT/scripts/inbox" >/dev/null 2>&1 || true

# Stage the (re)generated registry. `git add` is a no-op when content is
# unchanged, and — unlike `git diff` — correctly handles notes-log.md while it
# is still untracked (first commit).
if [ -n "$(git status --porcelain -- notes-log.md)" ]; then
  git add -- notes-log.md
  echo "pre-commit: notes-log.md updated and staged" >&2
fi

exit 0
