#!/bin/bash
# Keep notes-log.md in sync with trees/evergreen/ on every commit. This catches
# trees created outside `scripts/new` (e.g. `forester new` directly or an editor
# snippet) and title/date edits to existing trees. Rebuilds the registry and
# stages it if it changed. Never blocks a commit: a registry failure warns only.
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel)

if ! "$ROOT/scripts/registry"; then
  echo "pre-commit: scripts/registry failed; leaving notes-log.md untouched" >&2
  exit 0
fi

# Refresh the local inbox worklist too (gitignored, never staged) so stub /
# transient trees created outside scripts/new still show up.
"$ROOT/scripts/inbox" >/dev/null 2>&1 || true

# Refresh the "Recently updated" index (trees/evergreen/RCNT.tree). It ranks by
# git commit time, so at pre-commit it reflects the forest as of the *previous*
# commit (the in-progress one isn't recorded yet) — close enough, and it
# self-corrects on the next commit.
"$ROOT/scripts/recent" >/dev/null 2>&1 || true

# Stage the (re)generated registry and recent index. `git add` is a no-op when
# content is unchanged, and — unlike `git diff` — correctly handles files while
# they are still untracked (first commit).
for f in notes-log.md trees/evergreen/RCNT.tree; do
  if [ -n "$(git status --porcelain -- "$f")" ]; then
    git add -- "$f"
    echo "pre-commit: $f updated and staged" >&2
  fi
done

exit 0
