#!/usr/bin/env python3
"""Rebuild notes-log.md — the notes registry — from trees/public/.

This is the single source of truth for the registry's line format. `scripts/new`
and the pre-commit hook both call it, so the file stays canonical regardless of
how a tree was created. Self-locates the repo root from its own path, so it runs
from any cwd and inside git hooks.
"""
import glob
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Map \taxon values to the short slugs `scripts/new` uses for templates.
TAXON_SLUG = {
    "definition": "def", "theorem": "thm", "proposition": "prop",
    "lemma": "lemma", "reference": "ref", "person": "person",
    "institute": "institute",
}

# Macro libraries / scaffolds that are not notes.
SKIP = {"base-macros", "latex-preamble"}


def brace_arg(text, macro):
    """Return the balanced-brace argument of \\macro{...}, or None."""
    i = text.find("\\" + macro + "{")
    if i < 0:
        return None
    i += len(macro) + 2
    depth, out = 1, []
    while i < len(text) and depth:
        c = text[i]
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                break
        out.append(c)
        i += 1
    return "".join(out).strip()


def kind(text):
    tx = brace_arg(text, "taxon")
    if tx and "\\" not in tx:  # ignore macro-valued taxons (scaffold artifacts)
        return TAXON_SLUG.get(tx.lower(), tx.lower())
    tags = set(re.findall(r"\\tag\{([^}]*)\}", text))
    for t in ("blog", "potw", "private"):
        if t in tags:
            return t
    return "note"


def build():
    rows = []
    for path in glob.glob(os.path.join(ROOT, "trees/public/*.tree")):
        tid = os.path.splitext(os.path.basename(path))[0]
        if tid in SKIP:
            continue
        with open(path, encoding="utf-8") as f:
            text = f.read()
        # Permanent-note index only. Stub / lit-note stragglers that still live
        # under trees/public belong to the inbox, not this index.
        tags = set(re.findall(r"\\tag\{([^}]*)\}", text))
        if tags & {"stub", "private"}:
            continue
        date_raw = brace_arg(text, "date") or ""
        date = date_raw[:10] if len(date_raw) >= 10 else ""
        title = " ".join((brace_arg(text, "title") or "(untitled)").split())
        rows.append((date, tid, kind(text), title))

    # Undated scaffolds first, then by date ascending, so the newest note is last.
    rows.sort(key=lambda r: (r[0] != "", r[0], r[1]))

    out = ["# Notes registry", "",
           "Every tree created via `scripts/new`, newest last.", "",
           "This file is generated by `scripts/registry` (run automatically by",
           "`scripts/new` and the pre-commit hook). Do not hand-edit.", ""]
    for date, tid, k, title in rows:
        d = date if date else "??????????"
        out.append(f"- {d} · `{k}` · [{tid}](trees/public/{tid}.tree) — {title}")
    out.append("")
    return "\n".join(out), len(rows)


def main():
    content, n = build()
    with open(os.path.join(ROOT, "notes-log.md"), "w", encoding="utf-8") as f:
        f.write(content)
    print(f"notes-log.md: {n} entries", file=sys.stderr)


if __name__ == "__main__":
    main()
