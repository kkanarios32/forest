#!/usr/bin/env python3
"""Mirror trees/cards/*.tree prompts into Anki via AnkiConnect.

Each card tree holds exactly one `\\prompt{question}{answer}`, which supplies
both Anki fields; the tree's `\\title` is a short name for the card and is not
synced. Both sides are rendered from Forester to Anki's HTML — lists, emphasis,
code, links and citations become tags, math becomes MathJax. The tree's Forester id
is the card's stable identity; the Anki note id is written back into the tree as
`\\meta{anki}{<id>}` on first sync, so every later sync is idempotent (update,
not duplicate). Notes land in the `Forest` deck (override per card with
`\\meta{anki-deck}{DeckName}`) using the built-in `Basic` model, tagged
`forest` + `forest-id-<treeid>`.

Dry run by default — prints the plan and touches nothing. Pass --apply to
create/update notes in Anki and write ids back. Pass --prune (with --apply) to
delete Anki notes whose source card tree no longer exists.

    scripts/anki-sync              # show the plan
    scripts/anki-sync --apply      # do it
    scripts/anki-sync --apply --prune
"""
import argparse
import json
import os
import re
import sys
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CARDS_DIR = os.path.join(ROOT, "trees", "cards")
ANKI_URL = "http://localhost:8765"
DEFAULT_DECK = "Forest"
MODEL = "Basic"


# ---- AnkiConnect ------------------------------------------------------------

def anki(action, **params):
    payload = json.dumps({"action": action, "version": 6, "params": params}).encode()
    req = urllib.request.Request(
        ANKI_URL, data=payload, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=15) as r:
        resp = json.load(r)
    if resp.get("error"):
        raise RuntimeError(f"AnkiConnect error on '{action}': {resp['error']}")
    return resp["result"]


# ---- Forester parsing -------------------------------------------------------

def verbatim(s, i):
    """`\\verb<<<|...<<<` or `\\startverb...\\stopverb` at i -> (body, index)."""
    if s.startswith("\\verb<<<|", i):
        j = s.find("<<<", i + len("\\verb<<<|"))
        if j < 0:
            return None
        return s[i + len("\\verb<<<|"):j].strip("\n"), j + 3
    if s.startswith("\\startverb", i):
        j = s.find("\\stopverb", i)
        if j < 0:
            return None
        return s[i + len("\\startverb"):j].strip("\n"), j + len("\\stopverb")
    return None


def brace_arg(s, i):
    """s[i] must be '{'. Return (content, index just past the matching '}').

    A verbatim span is stepped over whole: braces inside \\verb<<<|...<<< are
    the code's, not the markup's, and counting them ends the argument early —
    which is exactly what a \\codeblock body, or a card whose \\prompt holds
    one, is full of."""
    depth, start = 0, i
    while i < len(s):
        c = s[i]
        if c == "\\":
            v = verbatim(s, i)
            if v is not None:
                i = v[1]
                continue
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return s[start + 1:i], i + 1
        i += 1
    raise ValueError("unbalanced braces")


def parse_prompt(text):
    """Extract (front, back) from \\prompt{question}{answer}, or None.

    Both sides come from \\prompt. The tree's \\title is a short name for the
    card — what it is about — and is deliberately not synced: Anki's front has
    to be the question itself, and a name is useless on a flashcard."""
    m = re.search(r"\\prompt\b", text)
    if not m:
        return None
    i = m.end()
    while i < len(text) and text[i] in " \t\r\n":
        i += 1
    if i >= len(text) or text[i] != "{":
        return None
    front, i = brace_arg(text, i)
    while i < len(text) and text[i] in " \t\r\n":
        i += 1
    if i >= len(text) or text[i] != "{":
        return None
    back, _ = brace_arg(text, i)
    return front.strip(), back.strip()


def meta(text, key):
    m = re.search(r"\\meta\{" + re.escape(key) + r"\}\{([^}]*)\}", text)
    return m.group(1).strip() if m else None


def brace_arg_named(text, macro):
    i = text.find("\\" + macro + "{")
    if i < 0:
        return None
    content, _ = brace_arg(text, i + len(macro) + 1)
    return content


# ---- Forester -> Anki (HTML + MathJax) --------------------------------------
#
# Anki fields are HTML, so the card text is *rendered*, not string-substituted:
# a single recursive pass that walks the source, hands math to MathJax verbatim,
# and turns structural markup into the HTML tags it means. Regex substitution
# cannot do this — \ul/\ol/\li nest, and a macro argument holding math or a
# nested macro has braces inside it that `[^}]*` cuts short.

MACRO = re.compile(r"\\([a-zA-Z][a-zA-Z0-9\-]*)")

INLINE_TAGS = {"strong": "b", "em": "i", "code": "code", "tt": "code"}


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def render_text(run, titles, in_list):
    """A prose run: resolve links, escape, and turn blank lines into breaks."""
    run = re.sub(r"\[([^\]\n]+)\]\([^)\s]+\)", r"\1", run)             # [text](ID) -> text
    run = re.sub(r"\[\[([0-9A-Za-z\-]+)\]\]",
                 lambda m: titles.get(m.group(1), m.group(1)), run)    # [[ID]] -> title
    if in_list and not run.strip():
        return ""                       # whitespace between \li items is layout, not text
    run = esc(run)
    run = re.sub(r"[ \t]*\n[ \t]*\n\s*", "<br><br>", run)              # paragraph break
    run = re.sub(r"\s*\n\s*", " ", run)                                # soft wrap
    return run


def read_args(s, i):
    """Consecutive brace groups starting at i (no whitespace between them)."""
    args = []
    while i < len(s) and s[i] == "{":
        arg, i = brace_arg(s, i)
        args.append(arg)
    return args, i


def expand(name, args, titles):
    r = lambda a: render(a, titles)
    if name in INLINE_TAGS and args:
        tag = INLINE_TAGS[name]
        return f"<{tag}>{r(args[0])}</{tag}>"
    if name in ("ul", "ol") and args:
        return f"<{name}>{render(args[0], titles, in_list=True)}</{name}>"
    if name == "li" and args:
        return f"<li>{r(args[0])}</li>"
    if name == "p" and args:
        return f"<p>{r(args[0])}</p>"
    if name == "hr":
        return "<hr>"
    if name in ("codeblock", "codeblockf") and args:
        # \codeblock{lang}{\verb<<<|...<<<}, \codeblockf{file}{lang}{...}. The
        # language drives highlight.js on the site and has nothing to colour on
        # a card, so it is dropped rather than printed; a filename is a caption
        # and is kept. Only the last argument is the code.
        body = args[-1].strip()
        v = verbatim(body, 0)
        code = f"<pre><code>{esc(v[0] if v else body)}</code></pre>"
        if name == "codeblockf" and len(args) >= 3:
            return f"<b>{esc(args[0].strip())}</b>{code}"
        return code
    if name == "citek" and args:                       # renders as [citekey] on-site
        return esc(f"[{args[0].strip()}]")
    if name == "citet" and len(args) >= 2:             # \citet{loc}{citekey}
        return esc(f"[{args[1].strip()}, {args[0].strip()}]")
    if name == "transclude" and args:
        key = args[0].strip()
        return esc(titles.get(key, key))
    if args:                                # unknown macro: keep the content, drop the name
        return " ".join(r(a) for a in args)
    return esc("\\" + name)


def render(s, titles, in_list=False):
    out, buf, i, n = [], [], 0, len(s)

    def flush():
        if buf:
            out.append(render_text("".join(buf), titles, in_list))
            del buf[:]

    while i < n:
        c = s[i]
        if c == "#" and s.startswith("##{", i):
            flush()
            content, i = brace_arg(s, i + 2)
            out.append("\\[" + content + "\\]")
        elif c == "#" and s.startswith("#{", i):
            flush()
            content, i = brace_arg(s, i + 1)
            out.append("\\(" + content + "\\)")
        elif c == "\\":
            v = verbatim(s, i)
            if v is not None:
                flush()
                body, i = v
                out.append(f"<pre><code>{esc(body)}</code></pre>")
                continue
            m = MACRO.match(s, i)
            if not m:
                buf.append(c)
                i += 1
                continue
            name, j = m.group(1), m.end()
            if name == "pre":                          # \pre\verb<<<|...<<<
                v = verbatim(s, j)
                if v is not None:
                    flush()
                    body, i = v
                    out.append(f"<pre><code>{esc(body)}</code></pre>")
                    continue
            args, i = read_args(s, j)
            flush()
            out.append(expand(name, args, titles))
        else:
            buf.append(c)
            i += 1
    flush()
    return "".join(out)


BLOCK = r"(?:ul|ol|li|p|pre|hr)"


def to_anki(s, titles):
    html = render(s, titles)
    # A block tag already breaks the line; a <br> against one is double spacing.
    html = re.sub(r"(?:<br>\s*)+(<" + BLOCK + r"\b[^>]*>)", r"\1", html)
    html = re.sub(r"(</?" + BLOCK + r">)(?:\s*<br>)+", r"\1", html)
    # Squeeze runs of spaces, but not inside <pre>, where they are the code's.
    html = "".join(part if i % 2 else re.sub(r"[ \t]{2,}", " ", part)
                   for i, part in enumerate(re.split(r"(<pre>.*?</pre>)", html, flags=re.S)))
    return html.strip()


def build_title_index():
    """id -> plain-text title, for resolving [[ID]] links in card text."""
    titles = {}
    trees = os.path.join(ROOT, "trees")
    for dirpath, _, files in os.walk(trees):
        for fn in files:
            if not fn.endswith(".tree"):
                continue
            path = os.path.join(dirpath, fn)
            try:
                text = open(path, encoding="utf-8", errors="ignore").read()
            except OSError:
                continue
            raw = brace_arg_named(text, "title")
            if raw:
                plain = re.sub(r"[#]{1,2}\{|\}|\\[a-zA-Z]+|\[\[|\]\]", "",
                               " ".join(raw.split()))
                titles[fn[:-5]] = plain.strip()
    return titles


# ---- Write the note id back into the card tree ------------------------------

def write_back_id(path, text, note_id):
    line = f"\\meta{{anki}}{{{note_id}}}"
    if re.search(r"\\meta\{anki\}\{[^}]*\}", text):
        new = re.sub(r"\\meta\{anki\}\{[^}]*\}", lambda m: line, text)
    elif "\\tag{card}\n" in text:
        new = text.replace("\\tag{card}\n", "\\tag{card}\n" + line + "\n", 1)
    else:
        new = re.sub(r"\n\\prompt", "\n" + line + "\n\\prompt", text, count=1)
    with open(path, "w", encoding="utf-8") as f:
        f.write(new)


# ---- Main -------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--apply", action="store_true",
                    help="create/update Anki notes and write ids back (default: dry run)")
    ap.add_argument("--prune", action="store_true",
                    help="with --apply, delete Anki notes whose card tree is gone")
    args = ap.parse_args()

    if not os.path.isdir(CARDS_DIR):
        print(f"no cards directory at {CARDS_DIR} — nothing to sync")
        return

    try:
        anki("version")
    except Exception as e:
        sys.exit(f"AnkiConnect unreachable ({e}). Is Anki running with the add-on?")

    titles = build_title_index()

    cards = []
    for fn in sorted(os.listdir(CARDS_DIR)):
        if not fn.endswith(".tree"):
            continue
        path = os.path.join(CARDS_DIR, fn)
        text = open(path, encoding="utf-8").read()
        try:
            parsed = parse_prompt(text)
        except ValueError as e:                 # unbalanced braces: skip, don't abort
            print(f"  skip   {fn[:-5]}: {e}")
            continue
        if parsed is None:
            print(f"  skip   {fn[:-5]}: no \\prompt{{question}}{{answer}} found")
            continue
        front, back = parsed
        if not front:
            print(f"  skip   {fn[:-5]}: \\prompt has an empty question")
            continue
        try:
            rendered = to_anki(front, titles), to_anki(back, titles)
        except ValueError as e:
            print(f"  skip   {fn[:-5]}: {e}")
            continue
        cards.append({
            "id": fn[:-5], "path": path, "text": text,
            "front": rendered[0], "back": rendered[1],
            "deck": meta(text, "anki-deck") or DEFAULT_DECK,
            "note_id": meta(text, "anki"),
        })

    if args.apply:
        for deck in sorted({c["deck"] for c in cards}):
            anki("createDeck", deck=deck)

    added = updated = 0
    for c in cards:
        nid = int(c["note_id"]) if c["note_id"] else None
        exists = bool(nid and anki("notesInfo", notes=[nid]) and
                      anki("notesInfo", notes=[nid])[0].get("noteId"))
        if exists:
            print(f"  update {c['id']} -> note {nid}  [{c['deck']}]")
            if args.apply:
                anki("updateNoteFields",
                     note={"id": nid, "fields": {"Front": c["front"], "Back": c["back"]}})
            updated += 1
        else:
            tag = f"forest-id-{c['id']}"
            note = {"deckName": c["deck"], "modelName": MODEL,
                    "fields": {"Front": c["front"], "Back": c["back"]},
                    "tags": ["forest", tag],
                    "options": {"allowDuplicate": False, "duplicateScope": "deck"}}
            print(f"  ADD    {c['id']} (new)     [{c['deck']}]")
            if args.apply:
                new_id = anki("addNote", note=note)
                write_back_id(c["path"], c["text"], new_id)
            added += 1

    # Orphans: forest-tagged Anki notes whose source card tree is gone.
    live_ids = {c["id"] for c in cards}
    orphans = []
    for nid in anki("findNotes", query="tag:forest"):
        info = anki("notesInfo", notes=[nid])[0]
        src = next((t[len("forest-id-"):] for t in info.get("tags", [])
                    if t.startswith("forest-id-")), None)
        if src is not None and src not in live_ids:
            orphans.append((nid, src))
    for nid, src in orphans:
        verb = "PRUNE " if (args.apply and args.prune) else "orphan"
        print(f"  {verb} note {nid} (was card {src})")
    if args.apply and args.prune and orphans:
        anki("deleteNotes", notes=[nid for nid, _ in orphans])

    mode = "applied" if args.apply else "dry run — pass --apply to sync"
    print(f"\n{len(cards)} cards · {added} to add · {updated} to update · "
          f"{len(orphans)} orphaned  ({mode})")


if __name__ == "__main__":
    main()
