#!/bin/bash
set -euo pipefail

TEMPLATE="${1:-}"

# Title is every argument after the template. A trailing `@citekey` token is
# pulled off as the source citation (for literature notes) rather than
# treated as part of the title.
ARGS=("${@:2}")
CITE=""
if [ "${#ARGS[@]}" -gt 0 ]; then
  LAST="${ARGS[${#ARGS[@]}-1]}"
  if [[ "$LAST" == @* ]]; then
    CITE="${LAST#@}"
    unset 'ARGS[${#ARGS[@]}-1]'
  fi
fi
TITLE="${ARGS[*]}"

if [ -z "$TEMPLATE" ] || [ -z "$TITLE" ]; then
  cat >&2 <<'USAGE'
usage: scripts/new <template> <title...> [@citekey]

  template: def thm prop lemma blog potw experiment  -> trees/public/    (permanent)
            stub                                      -> trees/stubs/     (concept stub / link target)
            lit-notes                                 -> trees/lit-notes/ (literature notes)
            note                                      -> trees/public/    (plain, no body)
  title:    display title (may contain spaces, no quotes needed)
  @citekey: optional source, seeds \citek{...} — use for literature notes

examples:
  scripts/new def Warp scheduling divergence
  scripts/new stub Total Store Order
  scripts/new lit-notes Store instruction lifecycle @henn2017
USAGE
  exit 1
fi

# Route by kind: the directory *is* the note's stage in the pipeline.
case "$TEMPLATE" in
  stub)      DEST="$FORESTDIR/trees/stubs" ;;
  lit-notes) DEST="$FORESTDIR/trees/lit-notes" ;;
  card)      DEST="$FORESTDIR/trees/cards" ;;
  *)         DEST="$FORESTDIR/trees/public" ;;
esac
mkdir -p "$DEST"

FILENAME=$(opam exec -- forester new --random --dest="$DEST")
echo "$FILENAME"

TPL="templates/$TEMPLATE.tree"

# forester emitted just `\date{...}`. Complete the standard frontmatter now that
# the title is known. Skip `\author` when the template opts out via
# `\meta{author}{false}` (e.g. literature notes).
{
  echo '\import{base-macros}'
  if [ ! -f "$TPL" ] || ! grep -q '\\meta{author}{false}' "$TPL"; then
    echo '\author{kellenkanarios}'
  fi
  echo "\\title{$TITLE}"
} >> "$FILENAME"

# Append the template body, dropping the frontmatter lines we just emitted
# (import / author / title) so they are not duplicated. Tags and \taxon stay.
if [ -f "$TPL" ]; then
  grep -vE '^\\(import\{base-macros\}|author\{[^}]*\}|title\{)' "$TPL" >> "$FILENAME" || true
fi

# Literature notes are bound to their source: seed the citation up front.
if [ -n "$CITE" ]; then
  printf '\n\\p{Source: \\citek{%s}.}\n' "$CITE" >> "$FILENAME"
fi

# Publish by default, but respect templates that opt out of the public site
# (stub / lit-notes). Never add a second public tag a template already declares.
if ! grep -q '\\tag{public}' "$FILENAME" \
   && ! grep -qE '\\tag\{(stub|private|card)\}' "$FILENAME"; then
  echo '\tag{public}' >> "$FILENAME"
fi

# Cards: the \title is the question (front); \prompt holds only the answer.
# `new card <question>` leaves an empty \prompt to fill; scripts/anki-sync
# mirrors \title -> Front and \prompt -> Back to Anki.
if [ "$TEMPLATE" = "card" ]; then
  printf '\n\\prompt{\n  \n}\n' >> "$FILENAME"
fi

# Refresh the derived views: notes-log.md (permanent index) and inbox.md
# (stub/lit-notes worklist). Both scripts are the single source of truth for format.
HERE="$(dirname "$0")"
"$HERE/registry"
"$HERE/inbox" >/dev/null

# If an fserve nvim server is listening, background-load the new tree so the
# forester LSP indexes it (fires FileType -> didOpen) and it becomes
# searchable by name without a full LSP restart.
if [ -n "${NVIM_SOCK:-}" ] && [ -S "${NVIM_SOCK:-}" ]; then
  nvim --server "$NVIM_SOCK" --remote-expr \
    "luaeval('vim.fn.bufload(vim.fn.bufadd(_A))', '$FILENAME')" >/dev/null 2>&1 || true
fi
