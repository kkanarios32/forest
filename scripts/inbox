#!/usr/bin/env python3
"""Rebuild inbox.md — the processing worklist — from the pipeline's WIP stages.

Counterpart to scripts/registry. Where notes-log.md is the permanent slip-box
index (grows forever), inbox.md is the work-in-progress queue you drive toward
zero, in three sections:

  * Stubs   — concept placeholders owing a body, ranked by inbound-link count
              (write the concepts your graph most depends on first).
  * Lit-notes — literature notes awaiting promotion into permanent notes,
              oldest first.

(The reading queue lives in an external capture tool, not the forest.)

Intentionally NOT committed (see .gitignore) so private scratch titles never
leave your machine. Also prints a one-line summary to stdout.
"""
import glob
import os
import re
import sys
from collections import Counter

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Reference forms that count as a link to a tree id.
REF_RE = re.compile(r"\[\[([A-Za-z0-9\-]+)\]\]"          # [[id]]
                    r"|\]\(([A-Za-z0-9\-]+)\)"            # [text](id)
                    r"|\\transclude\{([A-Za-z0-9\-]+)\}")  # \transclude{id}


def brace_arg(text, macro):
    """Return the balanced-brace argument of \\macro{...}, or None."""
    i = text.find("\\" + macro + "{")
    if i < 0:
        return None
    i += len(macro) + 2
    depth, out = 1, []
    while i < len(text) and depth:
        c = text[i]
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                break
        out.append(c)
        i += 1
    return "".join(out).strip()


def load_all():
    """Read every tree once. Return {id: (rel, tags, date, title, text)}."""
    trees = {}
    for path in glob.glob(os.path.join(ROOT, "trees/**/*.tree"), recursive=True):
        tid = os.path.splitext(os.path.basename(path))[0]
        with open(path, encoding="utf-8") as f:
            text = f.read()
        rel = os.path.relpath(path, ROOT)
        tags = set(re.findall(r"\\tag\{([^}]*)\}", text))
        date_raw = brace_arg(text, "date") or ""
        date = date_raw[:10] if len(date_raw) >= 10 else ""
        title = " ".join((brace_arg(text, "title") or "(untitled)").split())
        trees[tid] = (rel, tags, date, title, text)
    return trees


def inbound_counts(trees):
    """Count, per tree id, how many *other* trees reference it."""
    counts = Counter()
    for tid, (_rel, _tags, _date, _title, text) in trees.items():
        refs = {a or b or c for a, b, c in REF_RE.findall(text)}
        for r in refs:
            if r != tid:
                counts[r] += 1
    return counts


def main():
    trees = load_all()
    counts = inbound_counts(trees)

    stubs, lit = [], []
    for tid, (rel, tags, date, title, _text) in trees.items():
        if "stub" in tags:
            stubs.append((counts.get(tid, 0), date, tid, rel, title))
        elif "private" in tags and rel.startswith("trees/lit-notes/"):
            lit.append((date, tid, rel, title))

    stubs.sort(key=lambda r: (-r[0], r[1] != "", r[1], r[2]))  # most-linked first
    lit.sort(key=lambda r: (r[0] != "", r[0], r[1]))            # oldest first

    def stub_lines(rows):
        out = []
        for n, date, tid, rel, title in rows:
            d = date if date else "??????????"
            link = f"{n}↗" if n else "0↗"
            out.append(f"- **{link}** · {d} · [{tid}]({rel}) — {title}")
        return out or ["- _(empty)_"]

    def dated_lines(rows):
        out = []
        for date, tid, rel, title in rows:
            d = date if date else "??????????"
            out.append(f"- {d} · [{tid}]({rel}) — {title}")
        return out or ["- _(empty)_"]

    body = "\n".join([
        "# Inbox — notes to process",
        "",
        "Work-in-progress queue, generated by `scripts/inbox`. **Not committed**",
        "(gitignored). Drive it to zero.",
        "",
        f"## 🌱 Stubs to write — {len(stubs)}  _(most-linked first)_",
        "",
        "Concept placeholders owing a body. The `N↗` count is how many trees",
        "link each stub — write the load-bearing ones first.",
        "",
        *stub_lines(stubs),
        "",
        f"## ✍️ Lit-notes to refine — {len(lit)}  _(oldest first)_",
        "",
        *dated_lines(lit),
        "",
    ])
    with open(os.path.join(ROOT, "inbox.md"), "w", encoding="utf-8") as f:
        f.write(body)
    print(f"inbox.md: {len(stubs)} stubs, {len(lit)} lit-notes", file=sys.stderr)


if __name__ == "__main__":
    main()
