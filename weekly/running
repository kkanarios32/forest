#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "datetime",
#     "fitfile",
#     "garmindb==3.6.4",  # must match the garmindb-cli that builds the DB (schema version skew otherwise)
#     "matplotlib",
#     "numpy",
#     "pandas",
#     "requests",
# ]
# ///
#
# Fitness — a single figure: weekly running (wide, left) beside the habits
# completion grid (narrow, right). Running is the week's headline, so it takes
# most of the width; habits is the compact companion. Two hues (coral running,
# blue habits) keep the two measures visually independent. Saved as running.png.
#
# Running panel: recessive bars + a prominent 4-week trailing average line. The
# average is emitted only where a full four-week window of real data exists (NaN
# otherwise, which matplotlib skips): leading pre-running weeks are trimmed
# before the window is taken, so zero-filled rest weeks can't dilute the early
# points into a phantom ramp.
#
# Habits panel lives in hgrid.py so it can be drawn onto a shared axis.

import argparse
import os
import sys
from datetime import date, datetime, timedelta

import matplotlib.pyplot as plt
import matplotlib.transforms as mtransforms
import pandas as pd
import fitfile
from garmindb import GarminConnectConfigManager
from garmindb.garmindb import ActivitiesDb, Activities, Attributes, GarminDb
from matplotlib.patches import PathPatch
from matplotlib.path import Path

import hgrid

gc_config = GarminConnectConfigManager()
db_params_dict = gc_config.get_db_params()

garmin_db = GarminDb(db_params_dict)
garmin_act_db = ActivitiesDb(db_params_dict)
measurement_system = Attributes.measurements_type(garmin_db)
unit_strings = fitfile.units.unit_strings[measurement_system]
distance_units = {"miles": "m"}[unit_strings[fitfile.units.UnitTypes.distance_long]]

WEEKS = 16          # recent weeks to bucket before trimming leading empties
WINDOW = 4          # trailing weeks in the rolling average

# --- ink + marks (warm site palette; light-only) -----------------------------
BG = "#faf8f2"       # cream card ground (site "vellum" palette)
INK = "#7a5a2b"      # line-endpoint annotation, sharing the brown accent
MUTED = "#96938b"    # bar values, x labels
BAR = "#ded9cc"      # recessive bars (warm gray)
LINE = "#7a5a2b"     # prominent average line (brown accent)

BAR_MAX_PX = 24
RADIUS_PX = 4

def weekly_series(last_thu):
    """Miles per Friday-anchored week (Fri -> Thu) for the 16 weeks ending at
    `last_thu`, trimmed to the first week with real running, plus its 4-week
    trailing average (NaN until a full window)."""
    end_ts = datetime.combine(last_thu, datetime.max.time())
    # Fetch a couple of extra weeks so the oldest Fri->Thu bucket is fully covered.
    start_ts = end_ts - timedelta(weeks=WEEKS + 2)
    activities = Activities.get_for_period(garmin_act_db, start_ts, end_ts)

    runs = []
    for activity in activities:
        if activity.name is None or activity.distance is None or activity.moving_time is None:
            continue
        s = activity.distance
        t = (datetime.combine(date.min, activity.moving_time) - datetime.min).total_seconds() / 60
        if s > 0.5 and 5 < t / s < 15:  # pace/distance heuristic → it's a run
            d = activity.start_time.date()
            friday = d - timedelta(days=(d.weekday() - 4) % 7)  # Friday of its week
            runs.append((friday, s))

    if not runs:
        return None, None

    df = pd.DataFrame(runs, columns=["week", "miles"])
    weekly = df.groupby("week")["miles"].sum()

    last_fri = last_thu - timedelta(days=6)   # Friday starting the last full week
    full = pd.date_range(end=last_fri, periods=WEEKS, freq="7D")
    weekly = weekly.reindex(full.date, fill_value=0)
    weekly.index = pd.to_datetime(weekly.index)

    nonzero = weekly[weekly > 0]
    if nonzero.empty:
        return None, None
    weekly = weekly.loc[nonzero.index[0]:]

    roll = weekly.rolling(WINDOW, min_periods=WINDOW).mean()  # NaN until full
    return weekly, roll


def _rounded_top(x, y, w, h, rx, ry, color):
    rx, ry = min(rx, w / 2), min(ry, h)
    verts = [
        (x, y), (x + w, y), (x + w, y + h - ry),
        (x + w, y + h), (x + w - rx, y + h),
        (x + rx, y + h), (x, y + h), (x, y + h - ry), (x, y),
    ]
    codes = [Path.MOVETO, Path.LINETO, Path.LINETO, Path.CURVE3, Path.CURVE3,
             Path.LINETO, Path.CURVE3, Path.CURVE3, Path.CLOSEPOLY]
    return PathPatch(Path(verts, codes), facecolor=color, edgecolor="none",
                     linewidth=0, zorder=2)


def draw_running(ax, weekly, roll):
    n = len(weekly)
    miles = weekly.values
    ymax = 1.15 * max(miles.max(), 1)
    ax.set_xlim(-0.5, n - 0.5)
    ax.set_ylim(0, ymax)
    ax.axis("off")

    ax.figure.canvas.draw()
    ext = ax.get_window_extent()
    xppx = n / ext.width
    yppx = ymax / ext.height
    w = min(0.6, BAR_MAX_PX * xppx)
    rx, ry = RADIUS_PX * xppx, RADIUS_PX * yppx

    blended = mtransforms.blended_transform_factory(ax.transData, ax.transAxes)

    for i, v in enumerate(miles):
        if v > 0:
            ax.add_patch(_rounded_top(i - w / 2, 0, w, v, rx, ry, BAR))
            ax.text(i, v + ymax * 0.015, f"{round(v)}", ha="center", va="bottom",
                    fontsize=11, fontweight=400, color=MUTED, clip_on=False)
        ax.text(i, -0.05, weekly.index[i].strftime("%b %d"), ha="center",
                va="top", fontsize=12, color=MUTED, transform=blended,
                clip_on=False)

    ax.plot(range(n), roll.values, color=LINE, linewidth=2, zorder=3)

    valid = roll.dropna()
    if not valid.empty:
        xi = list(roll.index).index(valid.index[-1])
        yi = valid.iloc[-1]
        ax.plot(xi, yi, marker="o", markersize=8, markerfacecolor=LINE,
                markeredgecolor=BG, markeredgewidth=2, zorder=4)
        ax.annotate(f"{round(yi)} mi · {WINDOW}-week avg",
                    (xi, yi), xytext=(-2, 34), textcoords="offset points",
                    ha="right", va="bottom", fontsize=12, fontweight=500,
                    color=INK, zorder=5)


def _empty_running(ax):
    ax.axis("off")
    ax.text(0.5, 0.5, "No runs in this period", ha="center", va="center",
            color=MUTED, fontsize=13, transform=ax.transAxes)


def _label(fig, x, y, text):
    """A card section label: uppercase, muted, in the structural sans."""
    fig.text(x, y, text, ha="left", va="top", fontsize=11, fontweight=500,
             color=MUTED)


def main(argv):
    parser = argparse.ArgumentParser()
    parser.add_argument("dir", help="save directory")
    parser.add_argument("--thursday", metavar="YYYY-MM-DD",
                        help="review-week end (Thu); defaults to the most recent "
                             "completed Thursday. Pass to re-render a past week.")
    args = parser.parse_args(argv)
    save_dir = args.dir
    if args.thursday:
        last_thu = date.fromisoformat(args.thursday)
    else:
        today = date.today()
        last_thu = today - timedelta(days=((today.weekday() - 3) % 7 or 7))

    weekly, roll = weekly_series(last_thu)
    # A Habitify outage must not sink the running chart: fall back to an empty
    # habits panel (hgrid.draw renders a placeholder) rather than aborting.
    try:
        df = hgrid.fetch(last_thu)
    except Exception as e:                       # noqa: BLE001
        print(f"habits unavailable, skipping panel: {e}", file=sys.stderr)
        df = None

    plt.rcParams.update({
        "font.family": "sans-serif",
        "font.sans-serif": ["Work Sans", "DejaVu Sans", "Arial"],
        "font.serif": ["XCharter", "Charter", "DejaVu Serif"],  # the serif voice
        "font.size": 12,
        "font.weight": 400,
    })

    fig = plt.figure(figsize=(12, 8.4))
    fig.patch.set_facecolor(BG)
    # A single column: weekly mileage fills the top, full width; the habit grid
    # sits under it on the bottom-left, its habit names overflowing right into
    # the empty gutter. Each section carries an uppercase card label.
    axr = fig.add_axes([0.05, 0.585, 0.90, 0.34])
    axh = fig.add_axes([0.05, 0.07, 0.29, 0.36])
    axr.set_facecolor(BG)
    axh.set_facecolor(BG)

    _label(fig, 0.05, 0.965, "WEEKLY MILEAGE")
    _label(fig, 0.05, 0.45, "HABITS")

    if weekly is None:
        _empty_running(axr)
    else:
        draw_running(axr, weekly, roll)
    hgrid.draw(axh, df)

    os.makedirs(save_dir, exist_ok=True)
    fig.savefig(os.path.join(save_dir, "running.png"), dpi=200, facecolor=BG)
    plt.close(fig)


if __name__ == "__main__":
    main(sys.argv[1:])
